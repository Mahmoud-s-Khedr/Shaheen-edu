# Copy to .env.api-tests.local. This file is required by `pnpm api:test:full`
# and must contain credentials for a dedicated, non-production Bunny account.
SUPER_ADMIN_EMAIL=api-tests-superadmin@example.test
SUPER_ADMIN_PASSWORD=ChangeThisApiTestPassword123!
COOKIE_SECRET=api_tests_cookie_secret_change_me_at_least_32_characters
JWT_ACCESS_SECRET=api_tests_access_secret_change_me_at_least_32_characters
JWT_PARENT_ACCESS_SECRET=api_tests_parent_secret_change_me_at_least_32_chars
NATIONAL_ID_HMAC_SECRET=api_tests_hmac_secret_change_me_at_least_32_characters
NATIONAL_ID_ENCRYPTION_KEY=api_tests_encryption_key_change_me_at_least_32_chars
NATIONAL_ID_KEY_VERSION=1

# Dedicated non-production Bunny Storage zone only.
BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=replace-with-api-test-storage-zone
BUNNY_STORAGE_ACCESS_KEY_ID=replace-me
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-me
BUNNY_STORAGE_PULL_ZONE_URL=https://replace-me.b-cdn.net
BUNNY_STORAGE_TOKEN_KEY=replace-with-test-pull-zone-token-key

# Dedicated non-production Bunny Stream library only.
BUNNY_STREAM_LIBRARY_ID=replace-me
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_READ_ONLY_KEY=replace-me
BUNNY_STREAM_PLAYER_TOKEN_KEY=replace-me

# Absolute path on the host to a small valid MP4 used by the real Stream test.
API_TEST_VIDEO_FILE=/absolute/path/to/api-test-video.mp4
# Public URL already configured as the Bunny Stream webhook target for this test library.
API_TEST_BUNNY_WEBHOOK_URL=https://replace-me.example.test/api/v1/integrations/bunny-stream/webhook
