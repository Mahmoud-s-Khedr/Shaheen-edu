# Local development only. Copy/export these values; never use production credentials.
DEV_SEED_ALLOW_MUTATIONS=true
DEV_SEED_BASE_URL=http://localhost:3000
DEV_SEED_API_PREFIX=/api/v1
DEV_SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
DEV_SEED_SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
DEV_SEED_DEMO_PASSWORD=DevSeedPassword123!
DEV_SEED_BUNNY_STORAGE_CONFIGURED=true
DEV_SEED_BUNNY_STREAM_CONFIGURED=true
# Required: Bunny Stream must be configured to POST to this public HTTPS URL.
DEV_SEED_BUNNY_WEBHOOK_URL=https://your-tunnel.example/api/v1/integrations/bunny-stream/webhook
# DEV_SEED_TARGET=local
# For a non-local development target only:
# DEV_SEED_TARGET=staging
# DEV_SEED_CONFIRM_STAGING_MUTATIONS=true
