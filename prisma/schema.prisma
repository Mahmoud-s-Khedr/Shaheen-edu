model Asset {
  id                           String                        @id @default(cuid())
  provider                     AssetProvider
  kind                         AssetKind
  status                       AssetStatus                   @default(PENDING_UPLOAD)
  originalFilename             String
  filename                     String
  storageKey                   String?                       @unique
  mimeType                     String
  sizeBytes                    Int?
  checksum                     String?
  metadata                     Json?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  readyAt                      DateTime?
  failedAt                     DateTime?
  archivedAt                   DateTime?
  uploadedById                 String
  uploadedBy                   User                          @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  primaryFor                   ContentItem[]                 @relation("ContentPrimaryAsset")
  references                   AssetReference[]
  gradeCovers                  AcademicGrade[]               @relation("AcademicGradeCover")
  subjectCovers                Subject[]                     @relation("SubjectCover")
  courseCovers                 Course[]                      @relation("CourseCover")
  chapterCovers                Chapter[]                     @relation("ChapterCover")
  lessonCovers                 Lesson[]                      @relation("LessonCover")
  sectionCovers                Section[]                     @relation("SectionCover")
  video                        VideoAsset?
  questionAssets               QuestionAsset[]               @relation("QuestionAttachmentAsset")
  questionContentBlocks        QuestionContentBlock[]        @relation("QuestionContentBlockAsset")
  questionOptionContentBlocks  QuestionOptionContentBlock[]  @relation("QuestionOptionContentBlockAsset")
  questionContextContentBlocks QuestionContextContentBlock[] @relation("QuestionContextContentBlockAsset")
  paymentProofFor              ManualPaymentSubmission[]     @relation("ManualPaymentProof")
  questionImportBatches        QuestionImportBatch[]         @relation("QuestionImportSourceAsset")
  questionImportMedia          QuestionImportMedia[]         @relation("QuestionImportMediaAsset")

  @@index([status, kind, createdAt])
}

model AssetReference {
  id            String             @id @default(cuid())
  contentItemId String
  assetId       String
  type          AssetReferenceType @default(CONTENT_ATTACHMENT)
  sortOrder     Int
  createdAt     DateTime           @default(now())
  contentItem   ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, assetId])
  @@unique([contentItemId, sortOrder])
}

model VideoAsset {
  assetId                 String                @id
  asset                   Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  libraryId               String
  bunnyVideoId            String                @unique
  processingStatus        VideoProcessingStatus @default(CREATED)
  processingProgress      Int                   @default(0)
  durationSeconds         Int?
  thumbnailUrl            String?
  clientUploadCompletedAt DateTime?
  lastWebhookAt           DateTime?
  failureMetadata         Json?
  attempt                 Int                   @default(1)
  questionVideoLinks      QuestionVideoLink[]

  @@index([processingStatus])
}

/// Optional, ordered teaching outline for a VIDEO content item. It is kept
/// separate from the curriculum hierarchy: a topic is a segment inside one
/// video, not a chapter, lesson, or section.
model VideoOutlineTopic {
  id            String                @id @default(cuid())
  contentItemId String
  title         String
  startSeconds  Int?
  endSeconds    Int?
  sortOrder     Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contentItem   ContentItem           @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  concepts      VideoOutlineConcept[]

  @@unique([contentItemId, sortOrder])
  @@index([contentItemId])
}

model VideoOutlineConcept {
  id        String            @id @default(cuid())
  topicId   String
  title     String
  sortOrder Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  topic     VideoOutlineTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, sortOrder])
  @@index([topicId])
}

model QuestionSource {
  id              String             @id @default(cuid())
  type            QuestionSourceType
  titleAr         String
  titleEn         String?
  noteAr          String?
  noteEn          String?
  publisherUserId String?
  publisher       PartnerProfile?    @relation("QuestionSourcePublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  status          ContentStatus      @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String
  updatedById     String
  createdBy       User               @relation("QuestionSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User               @relation("QuestionSourceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions       Question[]

  @@index([status, type, createdAt, id])
  @@index([publisherUserId])
}

model QuestionBank {
  id                      String                   @id @default(cuid())
  /// Nullable only during the legacy-bank remediation rollout. New banks always
  /// receive a subject through the application API.
  subjectId               String?
  subject                 Subject?                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  title                   String
  description             String?
  status                  ContentStatus            @default(DRAFT)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  publishedAt             DateTime?
  archivedAt              DateTime?
  createdById             String
  updatedById             String
  createdBy               User                     @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy               User                     @relation("QuestionBankUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions               Question[]
  assessments             Assessment[]             @relation("AssessmentLegacyQuestionBank")
  assessmentQuestionBanks AssessmentQuestionBank[]

  @@index([status, createdAt, id])
  @@index([subjectId, status])
}

model Question {
  id                    String                     @id @default(cuid())
  bankId                String
  sourceId              String
  courseId              String
  type                  QuestionType               @default(SINGLE_CHOICE)
  body                  String
  explanation           String?
  maxPoints             Int                        @default(1)
  acceptedAnswers       Json?
  gradingRubric         String?
  answerOrigin          QuestionAnswerProvenance?
  answerReviewedAt      DateTime?
  answerReviewedById    String?
  status                QuestionStatus             @default(DRAFT)
  reviewNote            String?
  reviewedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdById           String
  updatedById           String
  reviewedById          String?
  bank                  QuestionBank               @relation(fields: [bankId], references: [id], onDelete: Restrict)
  source                QuestionSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  course                Course                     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy             User                       @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User                       @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reviewedBy            User?                      @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  answerReviewedBy      User?                      @relation("QuestionAnswerReviewedBy", fields: [answerReviewedById], references: [id], onDelete: Restrict)
  options               QuestionOption[]
  assets                QuestionAsset[]
  videoLink             QuestionVideoLink?
  placements            QuestionPlacement[]
  studentAttempts       StudentQuestionAttempt[]
  marks                 StudentQuestionMark[]
  notes                 StudentQuestionNote[]
  highlights            StudentQuestionHighlight[]
  communityStats        QuestionCommunityStat?
  importItem            QuestionImportItem?
  contexts              QuestionContextQuestion[]
  structuredExplanation QuestionExplanation?
  explanationRuns       QuestionAiExplanationRun[]
  reports               QuestionReport[]
  replacesQuestionId    String?
  replacesQuestion      Question?                  @relation("QuestionReplacement", fields: [replacesQuestionId], references: [id], onDelete: SetNull)
  replacementQuestions  Question[]                 @relation("QuestionReplacement")
  contentBlocks         QuestionContentBlock[]

  @@index([status, createdAt, id])
  @@index([bankId, status])
  @@index([sourceId, status])
  @@index([courseId, status])
  @@index([replacesQuestionId])
}

model QuestionContext {
  id             String                        @id @default(cuid())
  type           QuestionContextType           @default(TEXT)
  title          String?
  body           String
  languageCode   String                        @default("ar")
  sourceLocator  Json?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  questions      QuestionContextQuestion[]
  contentBlocks  QuestionContextContentBlock[]
  importContexts QuestionImportContext[]

  @@index([type, createdAt])
}

model QuestionContextQuestion {
  questionId String
  contextId  String
  sortOrder  Int             @default(1)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  context    QuestionContext @relation(fields: [contextId], references: [id], onDelete: Restrict)

  @@id([questionId, contextId])
  @@index([contextId])
}

model QuestionExplanation {
  id                  String                    @id @default(cuid())
  questionId          String                    @unique
  question            Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  languageCode        String                    @default("ar")
  keywords            String
  eliminationStrategy String
  whyCorrect          String
  generalRule         String
  whatIf              String
  commonMistakes      String
  origin              QuestionExplanationOrigin @default(HUMAN)
  model               String?
  confidence          Float?
  answerOrigin        QuestionAnswerOrigin?
  warnings            Json?
  sourceFingerprint   String?
  staleAt             DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

/// Every admin-triggered AI answer/explanation evaluation is retained for
/// audit and review. Only an explicitly applied run can change a question.
model QuestionAiExplanationRun {
  id                    String                         @id @default(cuid())
  questionId            String
  question              Question                       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mode                  QuestionAiExplanationRunMode
  status                QuestionAiExplanationRunStatus @default(PENDING_REVIEW)
  questionSnapshot      Json
  sourceFingerprint     String
  languageCode          String                         @default("ar")
  suppliedAnswer        Json?
  additionalContext     String?
  proposedAnswer        Json?
  structuredExplanation Json?
  confidence            Float?
  warnings              Json?
  conflictWarning       String?
  model                 String
  promptVersion         String
  rawResponse           Json?
  usage                 Json?
  createdById           String
  reviewedById          String?
  reviewedAt            DateTime?
  applyAnswer           Boolean?
  applyExplanation      Boolean?
  appliedQuestionId     String?
  reviewNote            String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([questionId, createdAt])
  @@index([status, createdAt])
}

model QuestionImportBatch {
  id                    String                         @id @default(cuid())
  inputType             QuestionImportInputType
  rawText               String?
  sourceAssetId         String?
  sourceAsset           Asset?                         @relation("QuestionImportSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  parentId              String?
  parent                QuestionImportBatch?           @relation("QuestionImportChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children              QuestionImportBatch[]          @relation("QuestionImportChildren")
  childSequence         Int?
  pageScope             Json?
  bankId                String
  sourceId              String
  courseId              String
  placements            Json
  status                QuestionImportStatus           @default(QUEUED)
  normalizedText        String?
  extractionMetadata    Json?
  segmentationRawOutput Json?
  segmentationUsage     Json?
  segmentationWarnings  Json?
  sourceTextEditedAt    DateTime?
  errorSummary          String?
  model                 String
  schemaVersion         String
  totalChunks           Int                            @default(0)
  completedChunks       Int                            @default(0)
  totalItems            Int                            @default(0)
  createdQuestions      Int                            @default(0)
  invalidItems          Int                            @default(0)
  failedItems           Int                            @default(0)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  startedAt             DateTime?
  completedAt           DateTime?
  createdById           String
  createdBy             User                           @relation("QuestionImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  chunks                QuestionImportChunk[]
  items                 QuestionImportItem[]
  sourceBlocks          QuestionImportSourceBlock[]
  answerEvidence        QuestionImportAnswerEvidence[]
  skippedRanges         QuestionImportSkippedRange[]
  pages                 QuestionImportPage[]
  media                 QuestionImportMedia[]
  importContexts        QuestionImportContext[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([parentId, childSequence])
}

/// The canonical, auditable transcription of one original PDF page.
model QuestionImportPage {
  id                           String                   @id @default(cuid())
  batchId                      String
  batch                        QuestionImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageNumber                   Int
  kind                         QuestionImportPageKind   @default(QUESTION)
  status                       QuestionImportPageStatus @default(PENDING)
  aiText                       String?
  canonicalText                String?
  confidence                   Float?
  uncertainSpans               Json?
  warnings                     Json?
  layoutEnvelopes              Json?
  attemptCount                 Int                      @default(0)
  providerFileId               String?
  rawProviderResponse          Json?
  initialAiText                String?
  initialCanonicalText         String?
  initialProviderResponse      Json?
  initialUsage                 Json?
  verificationProviderResponse Json?
  verificationUsage            Json?
  verifiedAt                   DateTime?
  usage                        Json?
  errorDetail                  String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@unique([batchId, pageNumber])
  @@index([batchId, status])
}

/// A durable, batch-local visual crop from a physical PDF page.  It remains
/// unassigned until the visual ownership phase validates an attachment.
model QuestionImportMedia {
  id               String                              @id @default(cuid())
  batchId          String
  batch            QuestionImportBatch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mediaKey         String
  pageNumber       Int
  normalizedBounds Json
  renderedBounds   Json
  pageDimensions   Json
  rotation         Int                                 @default(0)
  renderDpi        Int
  type             QuestionImportMediaType
  confidence       Float
  description      String
  warnings         Json?
  validationFlags  Json?
  cropCompleteness QuestionImportMediaCropCompleteness @default(UNKNOWN)
  cropVerification Json?
  checksum         String?
  assetId          String?                             @unique
  asset            Asset?                              @relation("QuestionImportMediaAsset", fields: [assetId], references: [id], onDelete: SetNull)
  status           QuestionImportMediaStatus           @default(REVIEW_REQUIRED)
  materializedAt   DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?
  errorDetail      String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  detections       QuestionImportMediaDetection[]
  assignments      QuestionImportMediaAssignment[]

  @@unique([batchId, mediaKey])
  @@index([batchId, pageNumber, status])
  @@index([batchId, checksum])
}

/// Stable, batch-local context identities used by visual extraction.  The
/// external model sees contextKey, never the database QuestionContext id.
model QuestionImportContext {
  id         String              @id @default(cuid())
  batchId    String
  batch      QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contextKey String
  contextId  String
  context    QuestionContext     @relation(fields: [contextId], references: [id], onDelete: Cascade)
  firstBlock String
  lastBlock  String
  createdAt  DateTime            @default(now())

  @@unique([batchId, contextKey])
  @@unique([batchId, contextId])
  @@index([contextId])
}

/// An auditable proposal/review record which maps one materialized crop to a
/// question, option, or shared context. finalContentBlockId is intentionally a
/// polymorphic reference because the final block can live in three tables.
model QuestionImportMediaAssignment {
  id                    String                              @id @default(cuid())
  importItemId          String
  importItem            QuestionImportItem                  @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  mediaId               String
  media                 QuestionImportMedia                 @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  assignmentKey         String
  /// Set only for QUESTION/OPTION ownership. A nullable unique key lets a
  /// shared context reuse its visual while making non-context ownership safe
  /// even when chunks are processed concurrently.
  exclusiveOwnershipKey String?
  owner                 QuestionImportMediaAssignmentOwner
  ownerReference        String
  placementAnchor       String?
  confidence            Float?
  reason                String?
  status                QuestionImportMediaAssignmentStatus @default(PROPOSED)
  scoreComponents       Json?
  evidenceVersion       String?
  reviewNote            String?
  reviewedAt            DateTime?
  reviewedById          String?
  finalContentBlockId   String?
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  @@unique([importItemId, assignmentKey])
  @@unique([exclusiveOwnershipKey])
  @@index([mediaId, status])
  @@index([importItemId, status])
}

/// A deterministic, reviewable visual contract for one imported candidate.
/// A candidate cannot create answer content until every requirement resolves.
model QuestionImportVisualRequirement {
  id                     String                              @id @default(cuid())
  importItemId           String
  importItem             QuestionImportItem                  @relation(fields: [importItemId], references: [id], onDelete: Cascade)
  requirementKey         String
  kind                   QuestionImportVisualRequirementKind
  sourcePage             Int?
  sourceEnvelope         Json?
  owner                  QuestionImportMediaAssignmentOwner?
  ownerReference         String?
  optionIndexes          Json?
  expectedCardinality    Int                                 @default(0)
  interpretationRequired Boolean                             @default(true)
  resolutionState        QuestionImportVisualResolutionState @default(PENDING)
  unresolvedReason       String?
  candidateRankings      Json?
  evidenceVersion        String?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  @@unique([importItemId, requirementKey])
  @@index([importItemId, resolutionState])
}

/// Keeps all model proposals and manual corrections even when they collapse
/// into a single canonical crop.
model QuestionImportMediaDetection {
  id               String                             @id @default(cuid())
  mediaId          String
  media            QuestionImportMedia                @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  source           QuestionImportMediaDetectionSource
  normalizedBounds Json
  type             QuestionImportMediaType
  confidence       Float?
  description      String?
  warnings         Json?
  rawEvidence      Json?
  validationFlags  Json?
  accepted         Boolean                            @default(false)
  createdById      String?
  createdAt        DateTime                           @default(now())

  @@index([mediaId, createdAt])
}

/// Neutral extracted source units. They are never assumed to be question
/// boundaries; Gemini identifies the question ranges over these block IDs.
model QuestionImportSourceBlock {
  id            String              @id @default(cuid())
  batchId       String
  batch         QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sequence      Int
  blockKey      String
  text          String
  sourceLocator Json?
  envelope      Json?
  assignment    Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([batchId, sequence])
  @@unique([batchId, blockKey])
  @@index([batchId])
}

/// A batch-local range containing an answer key, marking scheme, or other
/// source material that supports an imported answer.  It is intentionally
/// separate from a question range because answer keys commonly live elsewhere
/// in a paper.
model QuestionImportAnswerEvidence {
  id            String              @id @default(cuid())
  batchId       String
  batch         QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  evidenceKey   String
  firstBlock    String
  lastBlock     String
  text          String
  sourceLocator Json?
  questionIds   Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([batchId, evidenceKey])
  @@index([batchId])
}

model QuestionImportSkippedRange {
  id            String              @id @default(cuid())
  batchId       String
  batch         QuestionImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sequence      Int
  firstBlock    String
  lastBlock     String
  reason        String
  sourceLocator Json?
  createdAt     DateTime            @default(now())

  @@unique([batchId, sequence])
  @@index([batchId])
}

model QuestionImportChunk {
