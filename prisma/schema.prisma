  @@index([courseId, status, isPrimary, startsAt, endsAt])
  @@index([chapterId, status, isPrimary, startsAt, endsAt])
  @@index([lessonId, status, isPrimary, startsAt, endsAt])
  @@index([publisherUserId, startsAt])
  @@index([supersedesId])
}

model ReferralProgram {
  id                   String                     @id @default(cuid())
  partnerUserId        String
  partner              PartnerProfile             @relation("ReferralProgramPartner", fields: [partnerUserId], references: [userId], onDelete: Restrict)
  name                 String
  status               ReferralProgramStatus      @default(DRAFT)
  startsAt             DateTime
  endsAt               DateTime?
  usageLimit           Int?
  perStudentUsageLimit Int?
  appliesToAll         Boolean                    @default(true)
  courseId             String?
  course               Course?                    @relation("ReferralProgramCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId            String?
  chapter              Chapter?                   @relation("ReferralProgramChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  createdById          String
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  codes                ReferralCode[]
  rules                ReferralCommissionRule[]
  reviewRules          ReferralReviewRule[]
  attributions         OrderReferralAttribution[]

  @@index([partnerUserId, status, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model ReferralCode {
  id                   String                     @id @default(cuid())
  programId            String
  program              ReferralProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  code                 String                     @unique
  isActive             Boolean                    @default(true)
  startsAt             DateTime?
  endsAt               DateTime?
  usageLimit           Int?
  perStudentUsageLimit Int?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  attributions         OrderReferralAttribution[]

  @@index([programId, isActive])
}

model ReferralCommissionRule {
  id                        String                     @id @default(cuid())
  programId                 String
  program                   ReferralProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  version                   Int
  kind                      ReferralCommissionKind
  percentageBps             Int?
  fixedCommissionMinor      Int?
  maximumCommissionMinor    Int?
  currency                  String                     @default("EGP")
  startsAt                  DateTime
  endsAt                    DateTime?
  isActive                  Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  allocations               PartnerAllocation[]        @relation("AllocationReferralRule")
  orderReferralAttributions OrderReferralAttribution[]

  @@unique([programId, version])
  @@index([programId, isActive, startsAt, endsAt])
}

model ReferralReviewRule {
  id          String                 @id @default(cuid())
  programId   String
  program     ReferralProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  kind        ReferralReviewRuleKind
  action      ReferralReviewAction
  threshold   Int
  isActive    Boolean                @default(true)
  createdById String
  createdBy   User                   @relation("ReferralReviewRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  flags       ReferralReviewFlag[]

  @@index([programId, isActive])
}

model OrderReferralAttribution {
  id                String                 @id @default(cuid())
  orderId           String                 @unique
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  studentUserId     String
  student           StudentProfile         @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  referralCodeId    String
  referralCode      ReferralCode           @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referralProgramId String
  referralProgram   ReferralProgram        @relation(fields: [referralProgramId], references: [id], onDelete: Restrict)
  ruleId            String
  rule              ReferralCommissionRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  snapshot          Json
  createdAt         DateTime               @default(now())
  reviewFlags       ReferralReviewFlag[]

  @@index([referralProgramId, createdAt])
  @@index([referralCodeId, createdAt])
  @@index([studentUserId, createdAt])
}

model ReferralReviewFlag {
  id            String                     @id @default(cuid())
  attributionId String
  attribution   OrderReferralAttribution   @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  ruleId        String?
  rule          ReferralReviewRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  source        ReferralReviewFlagSource
  type          String
  action        ReferralReviewAction
  observedValue Int?
  threshold     Int?
  metadata      Json?
  status        ReferralReviewStatus       @default(OPEN)
  assignedToId  String?
  assignedTo    User?                      @relation("ReferralReviewFlagAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  disposition   ReferralReviewDisposition?
  resolvedById  String?
  resolvedBy    User?                      @relation("ReferralReviewFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  notes         ReferralReviewNote[]

  @@index([status, createdAt])
  @@index([attributionId])
  @@index([assignedToId, status])
}

model ReferralReviewNote {
  id          String             @id @default(cuid())
  flagId      String
  flag        ReferralReviewFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  body        String
  createdById String
  createdBy   User               @relation("ReferralReviewNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())

  @@index([flagId, createdAt])
}

model PartnerAllocation {
  id                          String                      @id @default(cuid())
  kind                        PartnerAllocationKind
  state                       PartnerAllocationState      @default(PAYABLE)
  partnerUserId               String
  partner                     PartnerProfile              @relation("AllocationPartner", fields: [partnerUserId], references: [userId], onDelete: Restrict)
  orderItemId                 String
  orderItem                   OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  publisherAgreementId        String?
  publisherAgreement          PublisherAgreement?         @relation("AllocationPublisherAgreement", fields: [publisherAgreementId], references: [id], onDelete: Restrict)
  referralRuleId              String?
  referralRule                ReferralCommissionRule?     @relation("AllocationReferralRule", fields: [referralRuleId], references: [id], onDelete: Restrict)
  basisMinor                  Int
  amountMinor                 Int
  currency                    String
  snapshot                    Json
  idempotencyKey              String                      @unique
  reversedAllocationId        String?                     @unique
  reversedAllocation          PartnerAllocation?          @relation("PartnerAllocationReversal", fields: [reversedAllocationId], references: [id], onDelete: Restrict)
  reversalOf                  PartnerAllocation?          @relation("PartnerAllocationReversal")
  payableAt                   DateTime                    @default(now())
  paidAt                      DateTime?
  reversedAt                  DateTime?
  createdAt                   DateTime                    @default(now())
  settlementLines             PartnerSettlementLine[]
  reconciliationDiscrepancies PartnerFinanceDiscrepancy[] @relation("ReconciliationAllocation")

  @@index([partnerUserId, state, createdAt])
  @@index([publisherAgreementId])
  @@index([referralRuleId])
}

model RefundPolicy {
  id                    String   @id @default(cuid())
