generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PARTNER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PartnerType {
  CONTENT_PUBLISHER
  REFERRAL_PARTNER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentItemType {
  TEXT
  EXTERNAL_LINK
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  DOWNLOADABLE_FILE
}

enum AccessType {
  PUBLIC
  FREE
  PAID
  INHERIT
}

enum EntitlementSource {
  ADMIN
  PROMOTION
  MIGRATION
  PAYMENT
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

enum CommerceTargetType {
  COURSE
  CHAPTER
}

enum OrderStatus {
  AWAITING_PAYMENT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ManualPaymentSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum PublisherAgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum AssetProvider {
  BUNNY_STORAGE
  BUNNY_STREAM
}

enum AssetKind {
  COVER_IMAGE
  IMAGE
  PAYMENT_PROOF
  PDF
  DOCUMENT
  DOWNLOADABLE_FILE
  VIDEO
}

enum AssetStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED_AWAITING_PROCESSING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssetReferenceType {
  CONTENT_ATTACHMENT
}

enum ArchivedAccessResourceType {
  ACADEMIC_GRADE
  SUBJECT
  COURSE
  CHAPTER
  LESSON
  SECTION
}

enum VideoProcessingStatus {
  CREATED
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum QuestionSourceType {
  PLATFORM
  CONTENT_PUBLISHER
  EXTERNAL_BOOK
  PREVIOUS_EXAM
  MINISTRY_MODEL
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AssessmentOwnerType {
  STUDENT
  ADMIN
}

enum AssessmentGenerationType {
  STANDARD
  CUSTOM
}

enum AssessmentMode {
  TUTOR
  EXAM
}

enum AssessmentStatus {
  DRAFT
  READY
  ARCHIVED
}

enum AssessmentAttemptStatus {
  SUSPENDED
  COMPLETED
}

enum AssessmentQuestionOutcome {
  CORRECT
  INCORRECT
  OMITTED
}

enum QuestionDifficultyBand {
  A_PLUS
  A
  B
  C
  D
}

model User {
  id                 String        @id @default(cuid())
  role               Role
  status             AccountStatus @default(ACTIVE)
  loginIdentifier    String        @unique
  passwordHash       String
  mustChangePassword Boolean       @default(false)
  passwordResetAt    DateTime?
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?
  deletedBy          User?         @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers       User[]        @relation("UserDeletedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  studentProfile                   StudentProfile?
  partnerProfile                   PartnerProfile?
  authSessions                     AuthSession[]
  auditLogsActor                   AdminAuditLog[]
  partnerProfilesCreated           PartnerProfile[]             @relation("PartnerProfileCreatedBy")
  entitlementsGranted              StudentEntitlement[]         @relation("EntitlementGrantedBy")
  entitlementsRevoked              StudentEntitlement[]         @relation("EntitlementRevokedBy")
  manualPaymentMethodsCreated      ManualPaymentMethod[]        @relation("ManualPaymentMethodCreatedBy")
  manualPaymentSubmissionsReviewed ManualPaymentSubmission[]    @relation("ManualPaymentSubmissionReviewedBy")
  publisherAgreementsCreated       PublisherAgreement[]         @relation("PublisherAgreementCreatedBy")
  earningsStatementsCreated        PublisherEarningsStatement[] @relation("EarningsStatementCreatedBy")

  academicGradesCreated     AcademicGrade[]          @relation("AcademicGradeCreatedBy")
  academicGradesUpdated     AcademicGrade[]          @relation("AcademicGradeUpdatedBy")
  subjectsCreated           Subject[]                @relation("SubjectCreatedBy")
  subjectsUpdated           Subject[]                @relation("SubjectUpdatedBy")
  coursesCreated            Course[]                 @relation("CourseCreatedBy")
  coursesUpdated            Course[]                 @relation("CourseUpdatedBy")
  chaptersCreated           Chapter[]                @relation("ChapterCreatedBy")
  chaptersUpdated           Chapter[]                @relation("ChapterUpdatedBy")
  lessonsCreated            Lesson[]                 @relation("LessonCreatedBy")
  lessonsUpdated            Lesson[]                 @relation("LessonUpdatedBy")
  sectionsCreated           Section[]                @relation("SectionCreatedBy")
  sectionsUpdated           Section[]                @relation("SectionUpdatedBy")
  contentItemsCreated       ContentItem[]            @relation("ContentItemCreatedBy")
  contentItemsUpdated       ContentItem[]            @relation("ContentItemUpdatedBy")
  assetsUploaded            Asset[]                  @relation("AssetUploadedBy")
  archivedAccessRevocations ArchivedAccessSnapshot[] @relation("ArchivedAccessRevokedBy")
  questionSourcesCreated    QuestionSource[]         @relation("QuestionSourceCreatedBy")
  questionSourcesUpdated    QuestionSource[]         @relation("QuestionSourceUpdatedBy")
  questionBanksCreated      QuestionBank[]           @relation("QuestionBankCreatedBy")
  questionBanksUpdated      QuestionBank[]           @relation("QuestionBankUpdatedBy")
  questionsCreated          Question[]               @relation("QuestionCreatedBy")
  questionsUpdated          Question[]               @relation("QuestionUpdatedBy")
  questionsReviewed         Question[]               @relation("QuestionReviewedBy")
  assessmentsCreated        Assessment[]             @relation("AssessmentCreatedByAdmin")
  leaderboardWeeksFinalized LeaderboardWeek[]        @relation("LeaderboardWeekFinalizedBy")

  @@index([role])
  @@index([role, createdAt, id])
  @@index([deletedById])
}

model StudentProfile {
  userId                  String                     @id
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  archivedAccessSnapshots ArchivedAccessSnapshot[]
  questionMarks           StudentQuestionMark[]
  fullName                String
  nationalIdHash          String                     @unique
  nationalIdEncrypted     String?
  nationalIdLast4         String
  nationalIdKeyVersion    Int                        @default(1)
  academicGradeId         String?
  academicGrade           AcademicGrade?             @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)
  governorate             String
  center                  String?
  governorateId           String
  centerId                String?
  governorateRef          Governorate?               @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  centerRef               Center?                    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  parentPhoneNormalized   String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  entitlements            StudentEntitlement[]
  contentStudyStates      StudentContentStudyState[]
  cart                    Cart?
  orders                  Order[]
  parentAccessSessions    ParentAccessSession[]
  contentProgress         StudentContentProgress[]
  questionAttempts        StudentQuestionAttempt[]
  assessments             Assessment[]
  assessmentAttempts      AssessmentAttempt[]
  leaderboardEntries      LeaderboardEntry[]

  @@unique([userId, parentPhoneNormalized])
  @@index([parentPhoneNormalized])
  @@index([parentPhoneNormalized, createdAt, userId])
  @@index([academicGradeId])
  @@index([governorateId])
  @@index([centerId])
}

model PartnerProfile {
  userId              String               @id
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerType         PartnerType
  displayName         String
  legalName           String?
  phone               String?
  createdByAdminId    String
  createdByAdmin      User                 @relation("PartnerProfileCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  publisherAgreements PublisherAgreement[] @relation("AgreementPublisher")
  questionSources     QuestionSource[]     @relation("QuestionSourcePublisher")
}

model AuthSession {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash    String       @unique
  familyId            String
  revoked             Boolean      @default(false)
  revokedAt           DateTime?
  replacedBySessionId String?      @unique
  replacedBy          AuthSession? @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replaces            AuthSession? @relation("AuthSessionReplacement")
  ipAddress           String?
  userAgent           String?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())

  @@index([userId])
  @@index([familyId])
}

model ParentAccessSession {
  id                    String          @id @default(cuid())
  parentPhoneNormalized String
  activeStudentId       String?
  activeStudent         StudentProfile? @relation(fields: [activeStudentId, parentPhoneNormalized], references: [userId, parentPhoneNormalized], onDelete: Restrict)
  revoked               Boolean         @default(false)
  revokedAt             DateTime?
  ipAddress             String?
  userAgent             String?
  expiresAt             DateTime
  createdAt             DateTime        @default(now())

  @@index([parentPhoneNormalized])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id])
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

model AcademicGrade {
  id            String        @id @default(cuid())
  titleAr       String
  titleEn       String?
  slug          String
  descriptionAr String?
  descriptionEn String?
  sortOrder     Int
  status        ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("AcademicGradeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("AcademicGradeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  subjects        Subject[]
  studentProfiles StudentProfile[]
  coverAsset      Asset?           @relation("AcademicGradeCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([slug])
  @@unique([sortOrder])
  @@index([status, sortOrder, id])
}

model Subject {
  id              String        @id @default(cuid())
  academicGradeId String
  academicGrade   AcademicGrade @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  courses       Course[]
  questionBanks QuestionBank[]
  coverAsset    Asset?         @relation("SubjectCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId  String?

  @@unique([academicGradeId, slug])
  @@unique([academicGradeId, sortOrder])
  @@index([academicGradeId, status, sortOrder, id])
}

model Course {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(PAID)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean    @default(false)

  createdBy User @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  chapters            Chapter[]
  questions           Question[]
  questionPlacements  QuestionPlacement[]          @relation("QuestionPlacementCourse")
  assessmentScopes    AssessmentScope[]            @relation("AssessmentScopeCourse")
  entitlements        StudentEntitlement[]
  cartItems           CartItem[]                   @relation("CartItemCourse")
  orderItems          OrderItem[]                  @relation("OrderItemCourse")
  publisherAgreements PublisherAgreement[]         @relation("PublisherAgreementCourse")
  earningsStatements  PublisherEarningsStatement[] @relation("EarningsCourse")
  contentPlacements   ContentPlacement[]           @relation("ContentPlacementCourse")
  coverAsset          Asset?                       @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?

  @@unique([subjectId, slug])
  @@unique([subjectId, sortOrder])
  @@index([subjectId, status, sortOrder, id])
}

model Chapter {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(INHERIT)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean?

  createdBy User @relation("ChapterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  lessons             Lesson[]
  entitlements        StudentEntitlement[]
  cartItems           CartItem[]                   @relation("CartItemChapter")
  orderItems          OrderItem[]                  @relation("OrderItemChapter")
  publisherAgreements PublisherAgreement[]         @relation("PublisherAgreementChapter")
  earningsStatements  PublisherEarningsStatement[] @relation("EarningsChapter")
  contentPlacements   ContentPlacement[]           @relation("ContentPlacementChapter")
  questionPlacements  QuestionPlacement[]          @relation("QuestionPlacementChapter")
  assessmentScopes    AssessmentScope[]            @relation("AssessmentScopeChapter")
  coverAsset          Asset?                       @relation("ChapterCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?

  @@unique([courseId, slug])
  @@unique([courseId, sortOrder])
  @@index([courseId, status, sortOrder, id])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(INHERIT)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean?

  createdBy User @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("LessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sections            Section[]
  publisherAgreements PublisherAgreement[]         @relation("PublisherAgreementLesson")
  earningsStatements  PublisherEarningsStatement[] @relation("EarningsLesson")
  contentPlacements   ContentPlacement[]           @relation("ContentPlacementLesson")
  coverAsset          Asset?                       @relation("LessonCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?
  questionPlacements  QuestionPlacement[]          @relation("QuestionPlacementLesson")
  assessmentScopes    AssessmentScope[]            @relation("AssessmentScopeLesson")

  @@unique([chapterId, slug])
  @@unique([chapterId, sortOrder])
  @@index([chapterId, status, sortOrder, id])
}

model Section {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(INHERIT)

  createdBy User @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SectionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  contentPlacements  ContentPlacement[]  @relation("ContentPlacementSection")
  coverAsset         Asset?              @relation("SectionCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId       String?
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementSection")
  assessmentScopes   AssessmentScope[]   @relation("AssessmentScopeSection")

  @@unique([lessonId, slug])
  @@unique([lessonId, sortOrder])
  @@index([lessonId, status, sortOrder, id])
}

model ContentItem {
  id                String          @id @default(cuid())
  type              ContentItemType
  title             String
  description       String?
  textBody          String?
  externalUrl       String?
  accessType        AccessType      @default(INHERIT)
  estimatedDuration Int?
  status            ContentStatus   @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy          User                       @relation("ContentItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User                       @relation("ContentItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  placement          ContentPlacement?
  primaryAssetId     String?
  primaryAsset       Asset?                     @relation("ContentPrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: Restrict)
  assetReferences    AssetReference[]
  studentProgress    StudentContentProgress[]
  studentStudyStates StudentContentStudyState[]

  @@index([status, createdAt, id])
}

model Asset {
  id               String                    @id @default(cuid())
  provider         AssetProvider
  kind             AssetKind
  status           AssetStatus               @default(PENDING_UPLOAD)
  originalFilename String
  filename         String
  storageKey       String?                   @unique
  mimeType         String
  sizeBytes        Int?
  checksum         String?
  metadata         Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  readyAt          DateTime?
  failedAt         DateTime?
  archivedAt       DateTime?
  uploadedById     String
  uploadedBy       User                      @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  primaryFor       ContentItem[]             @relation("ContentPrimaryAsset")
  references       AssetReference[]
  gradeCovers      AcademicGrade[]           @relation("AcademicGradeCover")
  subjectCovers    Subject[]                 @relation("SubjectCover")
  courseCovers     Course[]                  @relation("CourseCover")
  chapterCovers    Chapter[]                 @relation("ChapterCover")
  lessonCovers     Lesson[]                  @relation("LessonCover")
  sectionCovers    Section[]                 @relation("SectionCover")
  video            VideoAsset?
  questionAssets   QuestionAsset[]           @relation("QuestionAttachmentAsset")
  paymentProofFor  ManualPaymentSubmission[] @relation("ManualPaymentProof")

  @@index([status, kind, createdAt])
}

model AssetReference {
  id            String             @id @default(cuid())
  contentItemId String
  assetId       String
  type          AssetReferenceType @default(CONTENT_ATTACHMENT)
  sortOrder     Int
  createdAt     DateTime           @default(now())
  contentItem   ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, assetId])
  @@unique([contentItemId, sortOrder])
}

model VideoAsset {
  assetId                 String                @id
  asset                   Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  libraryId               String
  bunnyVideoId            String                @unique
  processingStatus        VideoProcessingStatus @default(CREATED)
  processingProgress      Int                   @default(0)
  durationSeconds         Int?
  thumbnailUrl            String?
  clientUploadCompletedAt DateTime?
  lastWebhookAt           DateTime?
  failureMetadata         Json?
  attempt                 Int                   @default(1)
  questionVideoLinks      QuestionVideoLink[]

  @@index([processingStatus])
}

model QuestionSource {
  id              String             @id @default(cuid())
  type            QuestionSourceType
  titleAr         String
  titleEn         String?
  noteAr          String?
  noteEn          String?
  publisherUserId String?
  publisher       PartnerProfile?    @relation("QuestionSourcePublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  status          ContentStatus      @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String
  updatedById     String
  createdBy       User               @relation("QuestionSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User               @relation("QuestionSourceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions       Question[]

  @@index([status, type, createdAt, id])
  @@index([publisherUserId])
}

model QuestionBank {
  id          String        @id @default(cuid())
  /// Nullable only during the legacy-bank remediation rollout. New banks always
  /// receive a subject through the application API.
  subjectId   String?
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  createdBy   User          @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User          @relation("QuestionBankUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions   Question[]
  assessments Assessment[] @relation("AssessmentLegacyQuestionBank")
  assessmentQuestionBanks AssessmentQuestionBank[]

  @@index([status, createdAt, id])
  @@index([subjectId, status])
}

model Question {
  id              String                   @id @default(cuid())
  bankId          String
  sourceId        String
  courseId        String
  type            QuestionType             @default(SINGLE_CHOICE)
  body            String
  explanation     String?
  status          QuestionStatus           @default(DRAFT)
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String
  updatedById     String
  reviewedById    String?
  bank            QuestionBank             @relation(fields: [bankId], references: [id], onDelete: Restrict)
  source          QuestionSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy       User                     @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                     @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reviewedBy      User?                    @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  options         QuestionOption[]
  assets          QuestionAsset[]
  videoLink       QuestionVideoLink?
  placements      QuestionPlacement[]
  studentAttempts StudentQuestionAttempt[]
  marks           StudentQuestionMark[]
  communityStats  QuestionCommunityStat?

  @@index([status, createdAt, id])
  @@index([bankId, status])
  @@index([sourceId, status])
  @@index([courseId, status])
}

model QuestionOption {
  id             String                         @id @default(cuid())
  questionId     String
  body           String
  isCorrect      Boolean                        @default(false)
  sortOrder      Int
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  question       Question                       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers StudentQuestionAttemptAnswer[]

  @@unique([questionId, sortOrder])
}

model QuestionAsset {
  id         String   @id @default(cuid())
  questionId String
  assetId    String
  sortOrder  Int
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  asset      Asset    @relation("QuestionAttachmentAsset", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([questionId, assetId])
  @@unique([questionId, sortOrder])
}

model QuestionVideoLink {
  id               String     @id @default(cuid())
  questionId       String     @unique
  videoAssetId     String
  timestampSeconds Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  question         Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  videoAsset       VideoAsset @relation(fields: [videoAssetId], references: [assetId], onDelete: Restrict)

  @@index([videoAssetId])
}

model QuestionPlacement {
  id         String   @id @default(cuid())
  questionId String
  courseId   String?
  chapterId  String?
  lessonId   String?
  sectionId  String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  course     Course?  @relation("QuestionPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter    Chapter? @relation("QuestionPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson     Lesson?  @relation("QuestionPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section    Section? @relation("QuestionPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([courseId])
  @@index([chapterId])
  @@index([lessonId])
  @@index([sectionId])
}

/// A student-generated or admin-generated quiz/exam. Ownership determines
/// visibility: a STUDENT-owned assessment is private to its owner; an
/// ADMIN-owned assessment is public to any student entitled to at least one
/// of its AssessmentScope targets.
model Assessment {
  id               String              @id @default(cuid())
  ownerType        AssessmentOwnerType
  studentUserId    String?
  student          StudentProfile?     @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  createdByAdminId String?
  createdByAdmin   User?               @relation("AssessmentCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  title             String
  generationType    AssessmentGenerationType
  mode              AssessmentMode           @default(EXAM)
  isTimed           Boolean                  @default(false)
  durationSeconds   Int?
  questionCount     Int
  status            AssessmentStatus         @default(READY)
  questionBankId    String?
  questionBank      QuestionBank?            @relation("AssessmentLegacyQuestionBank", fields: [questionBankId], references: [id], onDelete: Restrict)
  generationFilters Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  scopes    AssessmentScope[]
  questionBanks AssessmentQuestionBank[]
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([ownerType, studentUserId, status, createdAt, id])
  @@index([ownerType, createdByAdminId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([questionBankId])
}

model AssessmentQuestionBank {
  assessmentId  String
  questionBankId String
  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionBank  QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@id([assessmentId, questionBankId])
  @@index([questionBankId])
}

/// The hierarchy node(s) an assessment was generated from / is targeted at.
/// For an ADMIN-owned assessment, these rows also gate student visibility.
model AssessmentScope {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?    @relation("AssessmentScopeCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId    String?
  chapter      Chapter?   @relation("AssessmentScopeChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId     String?
  lesson       Lesson?    @relation("AssessmentScopeLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  sectionId    String?
  section      Section?   @relation("AssessmentScopeSection", fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
  @@index([courseId])
  @@index([chapterId])
  @@index([chapterId, assessmentId])
  @@index([lessonId])
  @@index([sectionId])
}

/// Immutable frozen snapshot of a question as included in an assessment at
/// generation time. sourceQuestionId is a plain (non-FK) reference so
/// archiving or hard-deleting the live Question can never alter or block
/// deletion of history already generated from it.
model AssessmentQuestion {
  id               String                     @id @default(cuid())
  assessmentId     String
  assessment       Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sourceQuestionId String
  sortOrder        Int
  type             QuestionType
  body             String
  explanation      String?
  options          AssessmentQuestionOption[]
  answers          AssessmentAttemptAnswer[]
  placements       AssessmentQuestionPlacement[]

  @@unique([assessmentId, sortOrder])
  @@index([assessmentId])
}

/// Immutable resolved hierarchy labels copied from the authored question when
/// an assessment is generated. They keep historical analytics stable when the
/// live hierarchy or a question's placements are later edited.
model AssessmentQuestionPlacement {
  id                   String             @id @default(cuid())
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  subjectId            String
  subjectTitle         String
  courseId             String
  courseTitle          String
  chapterId            String?
  chapterTitle         String?
  lessonId             String?
  lessonTitle          String?
  sectionId            String?
  sectionTitle         String?

  @@index([assessmentQuestionId])
  @@index([subjectId])
  @@index([chapterId])
}

model AssessmentQuestionOption {
  id                   String             @id @default(cuid())
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  body                 String
  isCorrect            Boolean
  sortOrder            Int

  @@unique([assessmentQuestionId, sortOrder])
}

/// One attempt per (assessment, student), enforced by the unique constraint
/// below. SUSPENDED attempts are mutable via autosave; COMPLETED attempts
/// are immutable (score/timestamps fixed at submission).
model AssessmentAttempt {
  id             String                    @id @default(cuid())
  assessmentId   String
  assessment     Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentUserId  String
  student        StudentProfile            @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  status         AssessmentAttemptStatus   @default(SUSPENDED)
  startedAt      DateTime                  @default(now())
  expiresAt      DateTime?
  lastActivityAt DateTime                  @default(now())
  submittedAt    DateTime?
  score          Int?
  totalQuestions Int
  answers        AssessmentAttemptAnswer[]

  @@unique([assessmentId, studentUserId])
  @@index([studentUserId, status, lastActivityAt])
  @@index([assessmentId])
  @@index([assessmentId, status, studentUserId])
}

/// Autosaved answer state per snapshot question. Upserted while the parent
/// attempt is SUSPENDED; frozen once it is COMPLETED.
model AssessmentAttemptAnswer {
  id                   String                     @id @default(cuid())
  attemptId            String
  attempt              AssessmentAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion         @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  selectedOptionIds    String[]
  isCorrect            Boolean?
  outcome              AssessmentQuestionOutcome?
  activeSeconds        Int                        @default(0)
  answeredAt           DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  answerChanges        AssessmentAnswerChange[]

  @@unique([attemptId, assessmentQuestionId])
  @@index([attemptId])
}

model AssessmentAnswerChange {
  id              String                    @id @default(cuid())
  attemptAnswerId String
  attemptAnswer   AssessmentAttemptAnswer   @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  fromOptionIds   String[]
  toOptionIds     String[]
  fromOutcome     AssessmentQuestionOutcome
  toOutcome       AssessmentQuestionOutcome
  changedAt       DateTime                  @default(now())

  @@index([attemptAnswerId, changedAt])
}

model LeaderboardWeek {
  id            String             @id @default(cuid())
  weekKey       String             @unique
  startsAt      DateTime
  endsAt        DateTime
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?              @relation("LeaderboardWeekFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  entries       LeaderboardEntry[]
  createdAt     DateTime           @default(now())

  @@index([startsAt, endsAt])
}

model LeaderboardEntry {
  id                String            @id @default(cuid())
  weekId            String
  week              LeaderboardWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  studentUserId     String
  student           StudentProfile    @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  academicGradeId   String?
  displayName       String
  rank              Int
  quizzesCompleted  Int
  totalQuestions    Int
  answeredQuestions Int
  correctAnswers    Int
  smartScore        Float
  accuracyPercent   Float
  award             LeaderboardAward?
  createdAt         DateTime          @default(now())

  @@unique([weekId, studentUserId])
  @@index([weekId, academicGradeId, rank])
}

model LeaderboardAward {
  id        String           @id @default(cuid())
  entryId   String           @unique
  entry     LeaderboardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tier      String
  label     String
  createdAt DateTime         @default(now())
}

model StudentQuestionMark {
  id            String         @id @default(cuid())
  studentUserId String
  questionId    String
  createdAt     DateTime       @default(now())
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, questionId])
  @@index([studentUserId, createdAt])
}

model QuestionCommunityStat {
  questionId         String                 @id
  totalResponses     Int                    @default(0)
  correctResponses   Int                    @default(0)
  incorrectResponses Int                    @default(0)
  incorrectRate      Float                  @default(0)
  difficultyBand     QuestionDifficultyBand @default(D)
  calculatedAt       DateTime               @default(now())
  question           Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([difficultyBand])
}

model BunnyStreamWebhookEvent {
  id           String   @id @default(cuid())
  eventKey     String   @unique
  bunnyVideoId String
  status       Int
  payload      Json
  receivedAt   DateTime @default(now())
}

model ContentPlacement {
  id                String   @id @default(cuid())
  contentItemId     String   @unique
  courseId          String?
  chapterId         String?
  lessonId          String?
  sectionId         String?
  academicGradeId   String
  subjectId         String
  resolvedCourseId  String
  resolvedChapterId String?
  resolvedLessonId  String?
  resolvedSectionId String?
  sortOrder         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  course      Course?     @relation("ContentPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter     Chapter?    @relation("ContentPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson      Lesson?     @relation("ContentPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section     Section?    @relation("ContentPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([courseId, sortOrder, id])
  @@index([chapterId, sortOrder, id])
  @@index([lessonId, sortOrder, id])
  @@index([sectionId, sortOrder, id])
  @@index([subjectId, resolvedCourseId, resolvedChapterId])
  @@index([academicGradeId, subjectId])
}

/// The only persisted content-completion state. Progress above an item is
/// intentionally derived from these rows, rather than stored redundantly.
model StudentContentProgress {
  id            String         @id @default(cuid())
  studentUserId String
  contentItemId String
  completedAt   DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, contentItemId])
  @@index([studentUserId, completedAt])
  @@index([contentItemId])
}

/// Private learner activity state. Completion remains intentionally separate
/// in StudentContentProgress so opening or resuming content never changes
/// course-progress calculations.
model StudentContentStudyState {
  id                      String         @id @default(cuid())
  studentUserId           String
  contentItemId           String
  lastOpenedAt            DateTime
  playbackPositionSeconds Int?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  student                 StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  contentItem             ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, contentItemId])
  @@index([studentUserId, lastOpenedAt, id])
  @@index([contentItemId])
}

/// Every submission is retained, including wrong answers and retries.
model StudentQuestionAttempt {
  id            String                         @id @default(cuid())
  studentUserId String
  questionId    String
  attemptNumber Int
  isCorrect     Boolean
  submittedAt   DateTime                       @default(now())
  student       StudentProfile                 @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question                       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers       StudentQuestionAttemptAnswer[]

  @@unique([studentUserId, questionId, attemptNumber])
  @@index([studentUserId, submittedAt])
  @@index([questionId, submittedAt])
}

model StudentQuestionAttemptAnswer {
  id        String                 @id @default(cuid())
  attemptId String
  optionId  String
  attempt   StudentQuestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  option    QuestionOption         @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, optionId])
  @@index([optionId])
}

model StudentEntitlement {
  id                      String                   @id @default(cuid())
  studentUserId           String
  student                 StudentProfile           @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  courseId                String?
  course                  Course?                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  chapterId               String?
  chapter                 Chapter?                 @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  orderItemId             String?                  @unique
  orderItem               OrderItem?               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  source                  EntitlementSource        @default(ADMIN)
  status                  EntitlementStatus        @default(ACTIVE)
  startsAt                DateTime                 @default(now())
  expiresAt               DateTime?
  revokedAt               DateTime?
  grantedById             String
  grantedBy               User                     @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedById             String?
  revokedBy               User?                    @relation("EntitlementRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  archivedAccessSnapshots ArchivedAccessSnapshot[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([studentUserId, status, startsAt, expiresAt])
  @@index([courseId])
  @@index([chapterId])
}

/// A durable record that a student held an effective entitlement when a hierarchy
/// node was archived. It intentionally survives expiry/revocation of its source.
model ArchivedAccessSnapshot {
  id                  String                     @id @default(cuid())
  studentUserId       String
  student             StudentProfile             @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  resourceType        ArchivedAccessResourceType
  resourceId          String
  sourceEntitlementId String
  sourceEntitlement   StudentEntitlement         @relation(fields: [sourceEntitlementId], references: [id], onDelete: Restrict)
  archivedAt          DateTime
  revokedAt           DateTime?
  revokedById         String?
  revokedBy           User?                      @relation("ArchivedAccessRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt           DateTime                   @default(now())

  @@unique([studentUserId, resourceType, resourceId])
  @@index([studentUserId, revokedAt])
  @@index([resourceType, resourceId])
}

model Cart {
  id            String         @id @default(cuid())
  studentUserId String         @unique
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  items         CartItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CartItem {
  id         String             @id @default(cuid())
  cartId     String
  cart       Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  targetType CommerceTargetType
  courseId   String?
  course     Course?            @relation("CartItemCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId  String?
  chapter    Chapter?           @relation("CartItemChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  createdAt  DateTime           @default(now())

  @@unique([cartId, courseId])
  @@unique([cartId, chapterId])
  @@index([cartId, createdAt])
}

model ManualPaymentMethod {
  id             String   @id @default(cuid())
  titleAr        String
  instructionsAr String
  titleEn        String?
  instructionsEn String?
  isActive       Boolean  @default(true)
  sortOrder      Int
  createdById    String
  createdBy      User     @relation("ManualPaymentMethodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@unique([sortOrder])
  @@index([isActive, sortOrder, id])
}

model Order {
  id                    String                    @id @default(cuid())
  studentUserId         String
  student               StudentProfile            @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  manualPaymentMethodId String
  manualPaymentMethod   ManualPaymentMethod       @relation(fields: [manualPaymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodSnapshot Json
  totalMinor            Int
  currency              String
  status                OrderStatus               @default(AWAITING_PAYMENT)
  items                 OrderItem[]
  submissions           ManualPaymentSubmission[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  approvedAt            DateTime?
  cancelledAt           DateTime?

  @@index([studentUserId, createdAt, id])
  @@index([status, createdAt, id])
}

model OrderItem {
  id            String              @id @default(cuid())
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  targetType    CommerceTargetType
  courseId      String?
  course        Course?             @relation("OrderItemCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId     String?
  chapter       Chapter?            @relation("OrderItemChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  titleSnapshot String
  priceMinor    Int
  currency      String
  entitlement   StudentEntitlement?
  createdAt     DateTime            @default(now())

  @@index([orderId])
}

model ManualPaymentSubmission {
  id                   String                        @id @default(cuid())
  orderId              String
  order                Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  proofAssetId         String
  proofAsset           Asset                         @relation("ManualPaymentProof", fields: [proofAssetId], references: [id], onDelete: Restrict)
  transactionReference String?
  note                 String?
  status               ManualPaymentSubmissionStatus @default(SUBMITTED)
  reviewedById         String?
  reviewedBy           User?                         @relation("ManualPaymentSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt, id])
  @@index([transactionReference])
}

model CommerceIdempotencyKey {
  id            String   @id @default(cuid())
  studentUserId String
  operation     String
  key           String
  resourceId    String
  createdAt     DateTime @default(now())

  @@unique([studentUserId, operation, key])
}

model PublisherAgreement {
  id              String                   @id @default(cuid())
  publisherUserId String
  publisher       PartnerProfile           @relation("AgreementPublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  courseId        String?
  course          Course?                  @relation("PublisherAgreementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId       String?
  chapter         Chapter?                 @relation("PublisherAgreementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId        String?
  lesson          Lesson?                  @relation("PublisherAgreementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  revenueShareBps Int
  startsAt        DateTime
  endsAt          DateTime?
  status          PublisherAgreementStatus @default(DRAFT)
  isPrimary       Boolean                  @default(true)
  createdById     String
  createdBy       User                     @relation("PublisherAgreementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  earningsStatements PublisherEarningsStatement[]

  @@index([courseId, status, isPrimary, startsAt, endsAt])
  @@index([chapterId, status, isPrimary, startsAt, endsAt])
  @@index([lessonId, status, isPrimary, startsAt, endsAt])
  @@index([publisherUserId, startsAt])
}

model PublisherEarningsStatement {
  id                     String             @id @default(cuid())
  agreementId            String
  agreement              PublisherAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  courseId               String?
  course                 Course?            @relation("EarningsCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId              String?
  chapter                Chapter?           @relation("EarningsChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId               String?
  lesson                 Lesson?            @relation("EarningsLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  periodStartsAt         DateTime
  periodEndsAt           DateTime
  grossRevenueMinor      Int
  currency               String
  revenueShareBps        Int
  publisherEarningsMinor Int
  createdById            String
  createdBy              User               @relation("EarningsStatementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime           @default(now())

  @@index([agreementId, periodStartsAt, periodEndsAt])
  @@index([courseId, periodStartsAt])
  @@index([chapterId, periodStartsAt])
  @@index([lessonId, periodStartsAt])
}

model Governorate {
  id        String           @id @default(cuid())
  nameAr    String           @unique
  nameEn    String?
  centers   Center[]
  students  StudentProfile[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Center {
  id            String           @id @default(cuid())
  governorateId String
  governorate   Governorate      @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  nameAr        String
  nameEn        String?
  students      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([governorateId, nameAr])
  @@index([governorateId])
}
