  releasedAt    DateTime?
  redeemedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([couponId, status, createdAt])
  @@index([couponId, studentUserId, status])
}

model PaymentReceipt {
  id               String          @id @default(cuid())
  orderId          String          @unique
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentAttemptId String?         @unique
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  reference        String          @unique
  snapshot         Json
  issuedAt         DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([issuedAt])
}

model ManualPaymentSubmission {
  id                   String                        @id @default(cuid())
  orderId              String
  order                Order                         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  proofAssetId         String                        @unique
  proofAsset           Asset                         @relation("ManualPaymentProof", fields: [proofAssetId], references: [id], onDelete: Restrict)
  transactionReference String?
  note                 String?
  status               ManualPaymentSubmissionStatus @default(SUBMITTED)
  reviewedById         String?
  reviewedBy           User?                         @relation("ManualPaymentSubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt, id])
  @@index([transactionReference])
}

/// A refund always covers complete approved order items. A request can include
/// multiple items so a student may refund part of a multi-item order without a
/// fractional refund or ambiguous entitlement state.
model RefundRequest {
  id                    String              @id @default(cuid())
  orderId               String
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  studentUserId         String
  student               StudentProfile      @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  status                RefundRequestStatus @default(PENDING)
  reason                String
  eligibilitySnapshot   Json
  rejectionReason       String?
  reviewNote            String?
  manualRefundReference String?
  reviewedById          String?
  reviewedBy            User?               @relation("RefundRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  requestedAt           DateTime            @default(now())
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  items                 RefundRequestItem[]

  @@index([studentUserId, requestedAt, id])
  @@index([orderId, status, requestedAt])
  @@index([status, requestedAt, id])
}

model RefundRequestItem {
  id              String        @id @default(cuid())
  refundRequestId String
  refundRequest   RefundRequest @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  orderItemId     String        @unique
