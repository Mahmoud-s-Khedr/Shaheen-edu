  checksum      String
  status        QuestionImportChunkStatus @default(PENDING)
  attemptCount  Int                       @default(0)
  rawResponse   Json?
  usage         Json?
  errorDetail   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  completedAt   DateTime?
  items         QuestionImportItem[]

