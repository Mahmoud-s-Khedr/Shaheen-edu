  currency        String
  createdAt       DateTime      @default(now())

  @@index([refundRequestId])
}

model CommerceIdempotencyKey {
  id            String   @id @default(cuid())
  studentUserId String
  operation     String
  key           String
  resourceId    String
  createdAt     DateTime @default(now())

  @@unique([studentUserId, operation, key])
  @@index([createdAt])
}

model PublisherAgreement {
  id                    String                   @id @default(cuid())
  publisherUserId       String
  publisher             PartnerProfile           @relation("AgreementPublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  courseId              String?
  course                Course?                  @relation("PublisherAgreementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId             String?
  chapter               Chapter?                 @relation("PublisherAgreementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId              String?
  lesson                Lesson?                  @relation("PublisherAgreementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  payoutKind            ReferralCommissionKind   @default(PERCENTAGE)
  revenueShareBps       Int?
  fixedPayoutMinor      Int?
  currency              String                   @default("EGP")
  contractReference     String?
  signedDocumentAssetId String?
  internalNote          String?
  version               Int                      @default(1)
  supersedesId          String?
  supersedes            PublisherAgreement?      @relation("PublisherAgreementVersion", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacements          PublisherAgreement[]     @relation("PublisherAgreementVersion")
  startsAt              DateTime
  endsAt                DateTime?
  status                PublisherAgreementStatus @default(DRAFT)
  isPrimary             Boolean                  @default(true)
