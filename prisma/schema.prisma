generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PARTNER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PartnerType {
  CONTENT_PUBLISHER
  REFERRAL_PARTNER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentItemType {
  TEXT
  EXTERNAL_LINK
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  DOWNLOADABLE_FILE
}

enum AccessType {
  PUBLIC
  FREE
  PAID
  INHERIT
}

enum EntitlementSource {
  ADMIN
  PROMOTION
  MIGRATION
  PAYMENT
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

enum PublisherAgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum AssetProvider {
  BUNNY_STORAGE
  BUNNY_STREAM
}

enum AssetKind {
  COVER_IMAGE
  IMAGE
  PDF
  DOCUMENT
  DOWNLOADABLE_FILE
  VIDEO
}

enum AssetStatus {
  PENDING_UPLOAD
  UPLOADING
  READY
  FAILED
  ARCHIVED
}

enum AssetReferenceType {
  CONTENT_ATTACHMENT
}

enum VideoProcessingStatus {
  CREATED
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum QuestionSourceType {
  PLATFORM
  CONTENT_PUBLISHER
  EXTERNAL_BOOK
  PREVIOUS_EXAM
  MINISTRY_MODEL
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

model User {
  id               String        @id @default(cuid())
  role             Role
  status           AccountStatus @default(ACTIVE)
  loginIdentifier  String        @unique
  passwordHash     String
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studentProfile   StudentProfile?
  partnerProfile   PartnerProfile?
  authSessions     AuthSession[]
  auditLogsActor   AdminAuditLog[]
  partnerProfilesCreated PartnerProfile[] @relation("PartnerProfileCreatedBy")
  entitlementsGranted StudentEntitlement[] @relation("EntitlementGrantedBy")
  entitlementsRevoked StudentEntitlement[] @relation("EntitlementRevokedBy")
  publisherAgreementsCreated PublisherAgreement[] @relation("PublisherAgreementCreatedBy")
  earningsStatementsCreated PublisherEarningsStatement[] @relation("EarningsStatementCreatedBy")

  academicGradesCreated AcademicGrade[] @relation("AcademicGradeCreatedBy")
  academicGradesUpdated AcademicGrade[] @relation("AcademicGradeUpdatedBy")
  subjectsCreated       Subject[]       @relation("SubjectCreatedBy")
  subjectsUpdated       Subject[]       @relation("SubjectUpdatedBy")
  coursesCreated        Course[]        @relation("CourseCreatedBy")
  coursesUpdated        Course[]        @relation("CourseUpdatedBy")
  chaptersCreated       Chapter[]       @relation("ChapterCreatedBy")
  chaptersUpdated       Chapter[]       @relation("ChapterUpdatedBy")
  lessonsCreated        Lesson[]        @relation("LessonCreatedBy")
  lessonsUpdated        Lesson[]        @relation("LessonUpdatedBy")
  sectionsCreated       Section[]       @relation("SectionCreatedBy")
  sectionsUpdated       Section[]       @relation("SectionUpdatedBy")
  contentItemsCreated   ContentItem[]   @relation("ContentItemCreatedBy")
  contentItemsUpdated   ContentItem[]   @relation("ContentItemUpdatedBy")
  assetsUploaded       Asset[] @relation("AssetUploadedBy")
  questionSourcesCreated QuestionSource[] @relation("QuestionSourceCreatedBy")
  questionSourcesUpdated QuestionSource[] @relation("QuestionSourceUpdatedBy")
  questionBanksCreated QuestionBank[] @relation("QuestionBankCreatedBy")
  questionBanksUpdated QuestionBank[] @relation("QuestionBankUpdatedBy")
  questionsCreated Question[] @relation("QuestionCreatedBy")
  questionsUpdated Question[] @relation("QuestionUpdatedBy")
  questionsReviewed Question[] @relation("QuestionReviewedBy")

  @@index([role])
  @@index([role, createdAt, id])
}

model StudentProfile {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  nationalIdHash        String   @unique
  nationalIdEncrypted   String?
  nationalIdLast4       String
  nationalIdKeyVersion  Int      @default(1)
  academicGradeId       String?
  academicGrade         AcademicGrade? @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)
  governorate           String
  center                String?
  governorateId         String
  centerId              String?
  governorateRef        Governorate? @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  centerRef             Center?      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  parentPhoneNormalized String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  entitlements          StudentEntitlement[]
  parentAccessSessions  ParentAccessSession[]

  @@index([parentPhoneNormalized])
  @@index([parentPhoneNormalized, createdAt, userId])
  @@index([academicGradeId])
  @@unique([userId, parentPhoneNormalized])
  @@index([governorateId])
  @@index([centerId])
}

model PartnerProfile {
  userId          String      @id
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerType     PartnerType
  displayName     String
  legalName       String?
  phone           String?
  createdByAdminId String
  createdByAdmin User @relation("PartnerProfileCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  publisherAgreements PublisherAgreement[] @relation("AgreementPublisher")
  questionSources QuestionSource[] @relation("QuestionSourcePublisher")
}

model AuthSession {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash     String    @unique
  familyId             String
  revoked              Boolean   @default(false)
  revokedAt            DateTime?
  replacedBySessionId  String? @unique
  replacedBy           AuthSession? @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replaces             AuthSession? @relation("AuthSessionReplacement")
  ipAddress            String?
  userAgent            String?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model ParentAccessSession {
  id                     String    @id @default(cuid())
  parentPhoneNormalized  String
  activeStudentId        String?
  activeStudent          StudentProfile? @relation(fields: [activeStudentId, parentPhoneNormalized], references: [userId, parentPhoneNormalized], onDelete: Restrict)
  revoked                Boolean   @default(false)
  revokedAt              DateTime?
  ipAddress              String?
  userAgent              String?
  expiresAt              DateTime
  createdAt              DateTime  @default(now())

  @@index([parentPhoneNormalized])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id])
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

model AcademicGrade {
  id          String        @id @default(cuid())
  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("AcademicGradeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("AcademicGradeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  subjects        Subject[]
  studentProfiles StudentProfile[]
  coverAsset      Asset? @relation("AcademicGradeCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([slug])
  @@unique([sortOrder])
  @@index([status, sortOrder, id])
}

model Subject {
  id              String        @id @default(cuid())
  academicGradeId String
  academicGrade   AcademicGrade @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  courses Course[]
  coverAsset      Asset? @relation("SubjectCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([academicGradeId, slug])
  @@unique([academicGradeId, sortOrder])
  @@index([academicGradeId, status, sortOrder, id])
}

model Course {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(PAID)
  priceMinor     Int?
  currency       String?
  isPurchasable  Boolean @default(false)

  createdBy User @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  chapters Chapter[]
  questions Question[]
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementCourse")
  entitlements StudentEntitlement[]
  publisherAgreements PublisherAgreement[] @relation("PublisherAgreementCourse")
  earningsStatements PublisherEarningsStatement[] @relation("EarningsCourse")
  contentPlacements ContentPlacement[] @relation("ContentPlacementCourse")
  coverAsset      Asset? @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([subjectId, slug])
  @@unique([subjectId, sortOrder])
  @@index([subjectId, status, sortOrder, id])
}

model Chapter {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(INHERIT)
  priceMinor     Int?
  currency       String?
  isPurchasable  Boolean?

  createdBy User @relation("ChapterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  lessons Lesson[]
  entitlements StudentEntitlement[]
  publisherAgreements PublisherAgreement[] @relation("PublisherAgreementChapter")
  earningsStatements PublisherEarningsStatement[] @relation("EarningsChapter")
  contentPlacements ContentPlacement[] @relation("ContentPlacementChapter")
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementChapter")
  coverAsset      Asset? @relation("ChapterCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([courseId, slug])
  @@unique([courseId, sortOrder])
  @@index([courseId, status, sortOrder, id])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(INHERIT)
  priceMinor     Int?
  currency       String?
  isPurchasable  Boolean?

  createdBy User @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("LessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sections Section[]
  publisherAgreements PublisherAgreement[] @relation("PublisherAgreementLesson")
  earningsStatements PublisherEarningsStatement[] @relation("EarningsLesson")
  contentPlacements ContentPlacement[] @relation("ContentPlacementLesson")
  coverAsset      Asset? @relation("LessonCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementLesson")

  @@unique([chapterId, slug])
  @@unique([chapterId, sortOrder])
  @@index([chapterId, status, sortOrder, id])
}

model Section {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(INHERIT)

  createdBy User @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SectionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  contentPlacements ContentPlacement[] @relation("ContentPlacementSection")
  coverAsset      Asset? @relation("SectionCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementSection")

  @@unique([lessonId, slug])
  @@unique([lessonId, sortOrder])
  @@index([lessonId, status, sortOrder, id])
}

model ContentItem {
  id                String             @id @default(cuid())
  type              ContentItemType
  title             String
  description       String?
  textBody          String?
  externalUrl       String?
  accessType        AccessType         @default(INHERIT)
  estimatedDuration Int?
  status            ContentStatus      @default(DRAFT)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("ContentItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ContentItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  placement ContentPlacement?
  primaryAssetId String?
  primaryAsset Asset? @relation("ContentPrimaryAsset", fields: [primaryAssetId], references: [id], onDelete: Restrict)
  assetReferences AssetReference[]

  @@index([status, createdAt, id])
}

model Asset {
  id                String @id @default(cuid())
  provider          AssetProvider
  kind              AssetKind
  status            AssetStatus @default(PENDING_UPLOAD)
  originalFilename  String
  filename          String
  storageKey        String? @unique
  mimeType          String
  sizeBytes         Int?
  checksum          String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  readyAt           DateTime?
  failedAt          DateTime?
  archivedAt        DateTime?
  uploadedById      String
  uploadedBy        User @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  primaryFor        ContentItem[] @relation("ContentPrimaryAsset")
  references        AssetReference[]
  gradeCovers       AcademicGrade[] @relation("AcademicGradeCover")
  subjectCovers     Subject[] @relation("SubjectCover")
  courseCovers      Course[] @relation("CourseCover")
  chapterCovers     Chapter[] @relation("ChapterCover")
  lessonCovers      Lesson[] @relation("LessonCover")
  sectionCovers     Section[] @relation("SectionCover")
  video             VideoAsset?
  questionAssets    QuestionAsset[] @relation("QuestionAttachmentAsset")
  @@index([status, kind, createdAt])
}

model AssetReference {
  id            String @id @default(cuid())
  contentItemId String
  assetId       String
  type          AssetReferenceType @default(CONTENT_ATTACHMENT)
  sortOrder     Int
  createdAt     DateTime @default(now())
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  asset         Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@unique([contentItemId, assetId])
  @@unique([contentItemId, sortOrder])
}

model VideoAsset {
  assetId           String @id
  asset             Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  libraryId          String
  bunnyVideoId       String @unique
  processingStatus   VideoProcessingStatus @default(CREATED)
  processingProgress Int @default(0)
  durationSeconds    Int?
  thumbnailUrl       String?
  lastWebhookAt      DateTime?
  failureMetadata    Json?
  attempt            Int @default(1)
  questionVideoLinks QuestionVideoLink[]
  @@index([processingStatus])
}

model QuestionSource {
  id              String             @id @default(cuid())
  type            QuestionSourceType
  title           String
  note            String?
  publisherUserId String?
  publisher       PartnerProfile?    @relation("QuestionSourcePublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  status          ContentStatus      @default(DRAFT)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String
  updatedById     String
  createdBy       User               @relation("QuestionSourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User               @relation("QuestionSourceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions       Question[]

  @@index([status, type, createdAt, id])
  @@index([publisherUserId])
}

model QuestionBank {
  id          String        @id @default(cuid())
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  createdBy   User          @relation("QuestionBankCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User          @relation("QuestionBankUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  questions   Question[]

  @@index([status, createdAt, id])
}

model Question {
  id           String         @id @default(cuid())
  bankId       String
  sourceId     String
  courseId     String
  type         QuestionType   @default(SINGLE_CHOICE)
  body         String
  explanation  String?
  status       QuestionStatus @default(DRAFT)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdById  String
  updatedById  String
  reviewedById String?
  bank         QuestionBank   @relation(fields: [bankId], references: [id], onDelete: Restrict)
  source       QuestionSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy    User           @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User           @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reviewedBy   User?          @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  options      QuestionOption[]
  assets       QuestionAsset[]
  videoLink    QuestionVideoLink?
  placements   QuestionPlacement[]

  @@index([status, createdAt, id])
  @@index([bankId, status])
  @@index([sourceId, status])
  @@index([courseId, status])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  body       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
}

model QuestionAsset {
  id         String   @id @default(cuid())
  questionId String
  assetId    String
  sortOrder  Int
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  asset      Asset    @relation("QuestionAttachmentAsset", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([questionId, assetId])
  @@unique([questionId, sortOrder])
}

model QuestionVideoLink {
  id               String   @id @default(cuid())
  questionId       String   @unique
  videoAssetId     String
  timestampSeconds Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  videoAsset       VideoAsset @relation(fields: [videoAssetId], references: [assetId], onDelete: Restrict)

  @@index([videoAssetId])
}

model QuestionPlacement {
  id         String   @id @default(cuid())
  questionId String
  courseId   String?
  chapterId  String?
  lessonId   String?
  sectionId  String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  course     Course?  @relation("QuestionPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter    Chapter? @relation("QuestionPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson     Lesson?  @relation("QuestionPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section    Section? @relation("QuestionPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([courseId])
  @@index([chapterId])
  @@index([lessonId])
  @@index([sectionId])
}

model BunnyStreamWebhookEvent {
  id          String @id @default(cuid())
  eventKey    String @unique
  bunnyVideoId String
  status      Int
  payload     Json
  receivedAt  DateTime @default(now())
}

model ContentPlacement {
  id            String   @id @default(cuid())
  contentItemId String   @unique
  courseId      String?
  chapterId     String?
  lessonId      String?
  sectionId     String?
  sortOrder     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  course      Course? @relation("ContentPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter     Chapter? @relation("ContentPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson      Lesson? @relation("ContentPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section     Section? @relation("ContentPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([courseId, sortOrder, id])
  @@index([chapterId, sortOrder, id])
  @@index([lessonId, sortOrder, id])
  @@index([sectionId, sortOrder, id])
}

model StudentEntitlement {
  id            String            @id @default(cuid())
  studentUserId String
  student       StudentProfile    @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  courseId      String?
  course        Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  chapterId     String?
  chapter       Chapter?          @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  source        EntitlementSource @default(ADMIN)
  status        EntitlementStatus @default(ACTIVE)
  startsAt      DateTime          @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  grantedById   String
  grantedBy     User              @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedById   String?
  revokedBy     User?             @relation("EntitlementRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([studentUserId, status, startsAt, expiresAt])
  @@index([courseId])
  @@index([chapterId])
}

model PublisherAgreement {
  id              String                   @id @default(cuid())
  publisherUserId String
  publisher       PartnerProfile           @relation("AgreementPublisher", fields: [publisherUserId], references: [userId], onDelete: Restrict)
  courseId        String?
  course          Course?                  @relation("PublisherAgreementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId       String?
  chapter         Chapter?                 @relation("PublisherAgreementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId        String?
  lesson          Lesson?                  @relation("PublisherAgreementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  revenueShareBps Int
  startsAt        DateTime
  endsAt          DateTime?
  status          PublisherAgreementStatus @default(DRAFT)
  isPrimary       Boolean                  @default(true)
  createdById     String
  createdBy       User                     @relation("PublisherAgreementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  earningsStatements PublisherEarningsStatement[]

  @@index([courseId, status, isPrimary, startsAt, endsAt])
  @@index([chapterId, status, isPrimary, startsAt, endsAt])
  @@index([lessonId, status, isPrimary, startsAt, endsAt])
  @@index([publisherUserId, startsAt])
}

model PublisherEarningsStatement {
  id                    String             @id @default(cuid())
  agreementId           String
  agreement             PublisherAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  courseId              String?
  course                Course?            @relation("EarningsCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId             String?
  chapter               Chapter?           @relation("EarningsChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId              String?
  lesson                Lesson?            @relation("EarningsLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  periodStartsAt        DateTime
  periodEndsAt          DateTime
  grossRevenueMinor     Int
  currency              String
  revenueShareBps       Int
  publisherEarningsMinor Int
  createdById           String
  createdBy             User               @relation("EarningsStatementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())

  @@index([agreementId, periodStartsAt, periodEndsAt])
  @@index([courseId, periodStartsAt])
  @@index([chapterId, periodStartsAt])
  @@index([lessonId, periodStartsAt])
}

model Governorate {
  id       String @id @default(cuid())
  name     String @unique
  centers  Center[]
  students StudentProfile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id            String @id @default(cuid())
  governorateId String
  governorate   Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  name          String
  students      StudentProfile[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([governorateId, name])
  @@index([governorateId])
}
