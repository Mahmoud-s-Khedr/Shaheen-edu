  eligibilityWindowDays Int
  maximumConsumptionBps Int
  isActive              Boolean  @default(true)
  updatedById           String
  updatedBy             User     @relation("RefundPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt             DateTime @default(now())

  @@index([isActive, createdAt])
}

model PartnerFinanceReconciliationRun {
  id            String                              @id @default(cuid())
  pilotLabel    String
  status        PartnerFinanceReconciliationStatus  @default(DRAFT)
  summary       Json?
  createdById   String
  createdBy     User                                @relation("ReconciliationRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt
  orders        PartnerFinanceReconciliationOrder[]
  discrepancies PartnerFinanceDiscrepancy[]

  @@index([status, createdAt])
}

model PartnerFinanceReconciliationOrder {
  runId   String
  orderId String
  run     PartnerFinanceReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  order   Order                           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([runId, orderId])
}

model PartnerFinanceDiscrepancy {
  id                  String                            @id @default(cuid())
  runId               String
  run                 PartnerFinanceReconciliationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  type                String
  expectedAmountMinor Int?
  actualAmountMinor   Int?
  expectedBasisMinor  Int?
  actualBasisMinor    Int?
  currency            String?
  orderItemId         String?
  orderItem           OrderItem?                        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  allocationId        String?
  allocation          PartnerAllocation?                @relation("ReconciliationAllocation", fields: [allocationId], references: [id], onDelete: Restrict)
  partnerUserId       String?
  severity            PartnerFinanceDiscrepancySeverity
  status              PartnerFinanceDiscrepancyStatus   @default(OPEN)
  assignedToId        String?
  assignedTo          User?                             @relation("ReconciliationDiscrepancyAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  notes               String?
  resolutionNote      String?
  resolvedById        String?
  resolvedBy          User?                             @relation("ReconciliationDiscrepancyResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt          DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@index([runId, status, severity])
  @@index([orderItemId])
  @@index([allocationId])
}

model PartnerSettlement {
  id               String                  @id @default(cuid())
  partnerUserId    String
  partner          PartnerProfile          @relation("SettlementPartner", fields: [partnerUserId], references: [userId], onDelete: Restrict)
  paymentReference String                  @unique
  currency         String                  @default("EGP")
  totalMinor       Int
  createdById      String
  paidAt           DateTime?
  createdAt        DateTime                @default(now())
  lines            PartnerSettlementLine[]

  @@index([partnerUserId, createdAt])
}

model PartnerSettlementLine {
  settlementId String
  allocationId String
  settlement   PartnerSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  allocation   PartnerAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)

  @@id([settlementId, allocationId])
  @@unique([allocationId])
}

model AssessmentQuestionAttribution {
  id                   String                    @id @default(cuid())
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion        @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  sourceId             String?
  sourceTitle          String?
  sourceType           QuestionSourceType?
  publisherUserId      String?
  publisherDisplayName String?
  role                 AssessmentAttributionRole @default(PRIMARY)
  weightBps            Int                       @default(10000)
  createdAt            DateTime                  @default(now())

  @@unique([assessmentQuestionId, role, sourceId, publisherUserId])
  @@index([publisherUserId, createdAt])
  @@index([sourceId])
}

/// Rebuildable, Cairo-calendar daily aggregates derived from frozen question
/// attribution and assessment attempts/answers. These rows are reporting
/// accelerators only; AssessmentAttempt and AssessmentQuestionAttribution
/// remain the audit source and PartnerAllocation remains the earnings source.
model PublisherUsageDailyRollup {
  id              String              @id @default(cuid())
  usageDate       DateTime            @db.Date
  publisherUserId String
  publisher       PartnerProfile      @relation(fields: [publisherUserId], references: [userId], onDelete: Restrict)
  sourceId        String?
  sourceKey       String
  sourceTitle     String?
  scope           PublisherUsageScope
  scopeId         String?
  scopeKey        String
  subjectId       String?
  courseId        String?
  chapterId       String?
  lessonId        String?
  sectionId       String?
  presented       Int                 @default(0)
  solved          Int                 @default(0)
  uniqueSolvers   Int                 @default(0)
  graded          Int                 @default(0)
  correct         Int                 @default(0)
  reattempts      Int                 @default(0)
  inputUpdatedAt  DateTime
  calculatedAt    DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([usageDate, publisherUserId, sourceKey, scopeKey])
  @@index([publisherUserId, usageDate, scope, scopeId])
  @@index([publisherUserId, sourceKey, usageDate])
}

/// Internal pseudonymous presence rows make distinct-solver counts exact when
/// daily rollups are combined into a monthly or arbitrary-range report. The
/// stable HMAC fingerprint never leaves aggregate reporting services.
model PublisherUsageDailySolver {
  id                 String         @id @default(cuid())
  usageDate          DateTime       @db.Date
  publisherUserId    String
  publisher          PartnerProfile @relation(fields: [publisherUserId], references: [userId], onDelete: Restrict)
  sourceKey          String
  scopeKey           String
  studentFingerprint String
  createdAt          DateTime       @default(now())

  @@unique([usageDate, publisherUserId, sourceKey, scopeKey, studentFingerprint])
  @@index([publisherUserId, sourceKey, scopeKey, usageDate])
}

model ReportExportJob {
  id             String                   @id @default(cuid())
  requestedById  String
  requestedBy    User                     @relation("ReportExportRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reportType     String
  filters        Json
  columns        Json
  reason         String?
  containsPii    Boolean                  @default(false)
  classification ReportDataClassification @default(NON_PII)
  status         ReportExportStatus       @default(QUEUED)
  storageKey     String?
  rowCount       Int?
  error          String?
  expiresAt      DateTime?
  downloadedAt   DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([requestedById, status, createdAt])
  @@index([status, createdAt])
}

model Governorate {
  id        String           @id @default(cuid())
  nameAr    String           @unique
  nameEn    String?
  centers   Center[]
  students  StudentProfile[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Center {
  id            String           @id @default(cuid())
  governorateId String
  governorate   Governorate      @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  nameAr        String
  nameEn        String?
  students      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([governorateId, nameAr])
  @@index([governorateId])
}
