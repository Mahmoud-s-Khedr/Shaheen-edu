model QuestionPlacement {
  id         String   @id @default(cuid())
  questionId String
  courseId   String?
  chapterId  String?
  lessonId   String?
  sectionId  String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  course     Course?  @relation("QuestionPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter    Chapter? @relation("QuestionPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson     Lesson?  @relation("QuestionPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section    Section? @relation("QuestionPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@index([courseId])
  @@index([chapterId])
  @@index([lessonId])
  @@index([sectionId])
}

/// A student-generated or admin-generated quiz/exam. Ownership determines
/// visibility: a STUDENT-owned assessment is private to its owner; an
/// ADMIN-owned assessment is public to any student entitled to at least one
/// of its AssessmentScope targets.
model Assessment {
  id               String              @id @default(cuid())
  ownerType        AssessmentOwnerType
  studentUserId    String?
  student          StudentProfile?     @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  createdByAdminId String?
  createdByAdmin   User?               @relation("AssessmentCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  title             String
  generationType    AssessmentGenerationType
  mode              AssessmentMode           @default(EXAM)
  isTimed           Boolean                  @default(false)
  durationSeconds   Int?
  questionCount     Int
  status            AssessmentStatus         @default(READY)
  questionBankId    String?
  questionBank      QuestionBank?            @relation("AssessmentLegacyQuestionBank", fields: [questionBankId], references: [id], onDelete: Restrict)
  generationFilters Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  scopes        AssessmentScope[]
  questionBanks AssessmentQuestionBank[]
  questions     AssessmentQuestion[]
  contexts      AssessmentContext[]
  attempts      AssessmentAttempt[]
  aiQuizRun     AiQuizGenerationRun?

  @@index([ownerType, studentUserId, status, createdAt, id])
  @@index([ownerType, createdByAdminId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([questionBankId])
}

model AssessmentQuestionBank {
  assessmentId   String
  questionBankId String
  assessment     Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@id([assessmentId, questionBankId])
  @@index([questionBankId])
}

/// The hierarchy node(s) an assessment was generated from / is targeted at.
/// For an ADMIN-owned assessment, these rows also gate student visibility.
model AssessmentScope {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?    @relation("AssessmentScopeCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId    String?
  chapter      Chapter?   @relation("AssessmentScopeChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lessonId     String?
  lesson       Lesson?    @relation("AssessmentScopeLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  sectionId    String?
  section      Section?   @relation("AssessmentScopeSection", fields: [sectionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
  @@index([courseId])
  @@index([chapterId])
  @@index([chapterId, assessmentId])
  @@index([lessonId])
  @@index([sectionId])
}

/// Immutable frozen snapshot of a question as included in an assessment at
/// generation time. sourceQuestionId is a plain (non-FK) reference so
/// archiving or hard-deleting the live Question can never alter or block
/// deletion of history already generated from it.
model AssessmentQuestion {
  id                    String                           @id @default(cuid())
  assessmentId          String
  assessment            Assessment                       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sourceQuestionId      String
  sortOrder             Int
  type                  QuestionType
  body                  String
  explanation           String?
  maxPoints             Int
  acceptedAnswers       Json?
  gradingRubric         String?
  answerOrigin          QuestionAnswerProvenance?
  videoAssetId          String?
  videoAssetName        String?
  timestampSeconds      Int?
  structuredExplanation Json?
  options               AssessmentQuestionOption[]
  answers               AssessmentAttemptAnswer[]
  placements            AssessmentQuestionPlacement[]
  contexts              AssessmentQuestionContext[]
  attachments           AssessmentQuestionAsset[]
  contentBlocks         AssessmentQuestionContentBlock[]
  attributions          AssessmentQuestionAttribution[]

  @@unique([assessmentId, sortOrder])
  @@index([assessmentId])
}

/// Immutable attachment metadata retained with an assessment question snapshot.
/// assetId intentionally remains a plain reference so assessment history does
/// not prevent deletion of the original live Question.
model AssessmentQuestionAsset {
  id                   String             @id @default(cuid())
  assessmentQuestionId String
  assetId              String
  assetKind            AssetKind
  assetName            String
  sortOrder            Int
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@unique([assessmentQuestionId, assetId])
  @@unique([assessmentQuestionId, sortOrder])
  @@index([assetId])
}

model AssessmentQuestionContentBlock {
  id                   String                   @id @default(cuid())
  assessmentQuestionId String
  type                 QuestionContentBlockType
  sortOrder            Int
  text                 String?
  assetId              String?
  assetKind            AssetKind?
  assetName            String?
  tableData            Json?
  latex                String?
  mathml               String?
  caption              String?
  altText              String?
  languageCode         String?
  assessmentQuestion   AssessmentQuestion       @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@unique([assessmentQuestionId, sortOrder])
  @@index([assetId])
}

model AssessmentContext {
  id              String                          @id @default(cuid())
  assessmentId    String
  assessment      Assessment                      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sourceContextId String
  type            QuestionContextType
  title           String?
  body            String
  languageCode    String
  sourceLocator   Json?
  createdAt       DateTime                        @default(now())
  questions       AssessmentQuestionContext[]
  contentBlocks   AssessmentContextContentBlock[]

  @@unique([assessmentId, sourceContextId])
  @@index([assessmentId])
}

model AssessmentQuestionContext {
  assessmentQuestionId String
  assessmentContextId  String
  sortOrder            Int                @default(1)
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  assessmentContext    AssessmentContext  @relation(fields: [assessmentContextId], references: [id], onDelete: Cascade)

  @@id([assessmentQuestionId, assessmentContextId])
  @@index([assessmentContextId])
}

model AssessmentContextContentBlock {
  id                  String                   @id @default(cuid())
  assessmentContextId String
  type                QuestionContentBlockType
  sortOrder           Int
  text                String?
  assetId             String?
  assetKind           AssetKind?
  assetName           String?
  tableData           Json?
  latex               String?
  mathml              String?
  caption             String?
  altText             String?
  languageCode        String?
  assessmentContext   AssessmentContext        @relation(fields: [assessmentContextId], references: [id], onDelete: Cascade)

  @@unique([assessmentContextId, sortOrder])
  @@index([assetId])
}

/// Immutable resolved hierarchy labels copied from the authored question when
/// an assessment is generated. They keep historical analytics stable when the
/// live hierarchy or a question's placements are later edited.
model AssessmentQuestionPlacement {
  id                   String             @id @default(cuid())
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  subjectId            String
  subjectTitle         String
  courseId             String
  courseTitle          String
  chapterId            String?
  chapterTitle         String?
  lessonId             String?
  lessonTitle          String?
  sectionId            String?
  sectionTitle         String?

  @@index([assessmentQuestionId])
  @@index([subjectId])
  @@index([chapterId])
}

model AssessmentQuestionOption {
  id                   String                                 @id @default(cuid())
  assessmentQuestionId String
  assessmentQuestion   AssessmentQuestion                     @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  body                 String
  isCorrect            Boolean
  sortOrder            Int
  contentBlocks        AssessmentQuestionOptionContentBlock[]

  @@unique([assessmentQuestionId, sortOrder])
}

model AssessmentQuestionOptionContentBlock {
  id                         String                   @id @default(cuid())
  assessmentQuestionOptionId String
  type                       QuestionContentBlockType
  sortOrder                  Int
  text                       String?
  assetId                    String?
  assetKind                  AssetKind?
  assetName                  String?
  tableData                  Json?
  latex                      String?
  mathml                     String?
  caption                    String?
  altText                    String?
  languageCode               String?
  assessmentQuestionOption   AssessmentQuestionOption @relation(fields: [assessmentQuestionOptionId], references: [id], onDelete: Cascade)

  @@unique([assessmentQuestionOptionId, sortOrder])
  @@index([assetId])
}

/// One attempt per (assessment, student), enforced by the unique constraint
/// below. SUSPENDED attempts are mutable via autosave; COMPLETED attempts
/// are immutable (score/timestamps fixed at submission).
model AssessmentAttempt {
  id             String                    @id @default(cuid())
  assessmentId   String
  assessment     Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentUserId  String
  student        StudentProfile            @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  status         AssessmentAttemptStatus   @default(SUSPENDED)
  startedAt      DateTime                  @default(now())
  expiresAt      DateTime?
  lastActivityAt DateTime                  @default(now())
  submittedAt    DateTime?
  score          Int?
  totalPoints    Int
  totalQuestions Int
  answers        AssessmentAttemptAnswer[]

  @@unique([assessmentId, studentUserId])
  @@index([studentUserId, status, lastActivityAt])
  @@index([assessmentId])
  @@index([assessmentId, status, studentUserId])
}

/// Autosaved answer state per snapshot question. Upserted while the parent
/// attempt is SUSPENDED; frozen once it is COMPLETED.
model AssessmentAttemptAnswer {
  id                      String                         @id @default(cuid())
  attemptId               String
  attempt                 AssessmentAttempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentQuestionId    String
  assessmentQuestion      AssessmentQuestion             @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)
  selectedOptionIds       String[]
  responseText            String?
  responseVersion         Int                            @default(0)
  inputMethod             AnswerInputMethod              @default(TEXT)
  responseLanguageCode    String?
  transcriptionProvider   String?
  transcriptionConfidence Float?
  isCorrect               Boolean?
  outcome                 AssessmentQuestionOutcome?
  awardedPoints           Int?
  gradedAt                DateTime?
  gradedById              String?
  gradedBy                User?                          @relation("AssessmentAnswerGradedBy", fields: [gradedById], references: [id], onDelete: Restrict)
  graderFeedback          String?
  activeSeconds           Int                            @default(0)
  answeredAt              DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  answerChanges           AssessmentAnswerChange[]
  aiGradingRuns           AssessmentAnswerAiGradingRun[]

  @@unique([attemptId, assessmentQuestionId])
  @@index([attemptId])
  @@index([outcome, answeredAt])
}

/// Immutable records of AI score/feedback proposals.  The current accepted
/// result is copied to the answer fields, but every model response remains
/// reviewable and an administrator can override it later.
model AssessmentAnswerAiGradingRun {
  id                   String                     @id @default(cuid())
  attemptAnswerId      String
  attemptAnswer        AssessmentAttemptAnswer    @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  status               AiRunStatus                @default(PENDING)
  questionSnapshot     Json
  responseSnapshot     String
  responseVersion      Int                        @default(0)
  responseLanguageCode String
  proposedPoints       Int?
  proposedOutcome      AssessmentQuestionOutcome?
  feedback             String?
  highlights           Json?
  model                String?
  promptVersion        String
  rawResponse          Json?
  usage                Json?
  error                String?
  createdAt            DateTime                   @default(now())
  completedAt          DateTime?

  @@index([attemptAnswerId, createdAt])
  @@index([status, createdAt])
}

/// The AI interpretation of a student request is retained separately from the
/// assessment snapshot so it is auditable without trusting model output.
model AiQuizGenerationRun {
  id                  String         @id @default(cuid())
  studentUserId       String
  student             StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  assessmentId        String?        @unique
  assessment          Assessment?    @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  status              AiRunStatus    @default(PENDING)
  prompt              String
  requestedFilters    Json
  normalizedPlan      Json?
  rationale           String?
  eligibleQuestionIds Json?
  selectedQuestionIds Json?
  model               String?
  promptVersion       String
  rawResponse         Json?
  usage               Json?
  error               String?
  createdAt           DateTime       @default(now())
  completedAt         DateTime?

  @@index([studentUserId, createdAt])
  @@index([status, createdAt])
}

model QuestionReport {
  id               String                 @id @default(cuid())
  questionId       String
  question         Question               @relation(fields: [questionId], references: [id], onDelete: Restrict)
  studentUserId    String
  student          StudentProfile         @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  type             QuestionReportType
  note             String?
  questionSnapshot Json
  status           QuestionReportStatus   @default(OPEN)
  assignedToId     String?
  assignedTo       User?                  @relation("QuestionReportReviewedBy", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  actions          QuestionReportAction[]

  @@index([status, createdAt])
  @@index([questionId, status])
}

model QuestionReportAction {
  id          String                @id @default(cuid())
  reportId    String
  report      QuestionReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User                  @relation("QuestionReportActionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  fromStatus  QuestionReportStatus?
  toStatus    QuestionReportStatus
  note        String?
  createdAt   DateTime              @default(now())

  @@index([reportId, createdAt])
}

model AssessmentAnswerChange {
  id               String                    @id @default(cuid())
  attemptAnswerId  String
  attemptAnswer    AssessmentAttemptAnswer   @relation(fields: [attemptAnswerId], references: [id], onDelete: Cascade)
  fromOptionIds    String[]
  toOptionIds      String[]
  fromResponseText String?
  toResponseText   String?
  fromOutcome      AssessmentQuestionOutcome
  toOutcome        AssessmentQuestionOutcome
  changedAt        DateTime                  @default(now())

  @@index([attemptAnswerId, changedAt])
}

model LeaderboardWeek {
  id            String             @id @default(cuid())
  weekKey       String             @unique
  startsAt      DateTime
  endsAt        DateTime
  finalizedAt   DateTime?
  finalizedById String?
  finalizedBy   User?              @relation("LeaderboardWeekFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  entries       LeaderboardEntry[]
  createdAt     DateTime           @default(now())

  @@index([startsAt, endsAt])
}

model LeaderboardEntry {
  id                String            @id @default(cuid())
  weekId            String
  week              LeaderboardWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  studentUserId     String
  student           StudentProfile    @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  academicGradeId   String?
  displayName       String
  rank              Int
  quizzesCompleted  Int
  totalQuestions    Int
  answeredQuestions Int
  correctAnswers    Int
  smartScore        Float
  accuracyPercent   Float
  award             LeaderboardAward?
  createdAt         DateTime          @default(now())

  @@unique([weekId, studentUserId])
  @@index([weekId, academicGradeId, rank])
  @@index([weekId, rank])
}

model LeaderboardAward {
  id        String           @id @default(cuid())
  entryId   String           @unique
  entry     LeaderboardEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tier      String
  label     String
  createdAt DateTime         @default(now())
}

model StudentQuestionMark {
  id            String         @id @default(cuid())
  studentUserId String
  questionId    String
  createdAt     DateTime       @default(now())
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, questionId])
  @@index([studentUserId, createdAt])
}

/// A student's private, editable note for one authored question. Assessment
/// questions retain their sourceQuestionId, so the same note follows a
/// question between direct practice and every assessment snapshot.
model StudentQuestionNote {
  id            String         @id @default(cuid())
  studentUserId String
  questionId    String
  body          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, questionId])
  @@index([studentUserId, updatedAt])
}

model QuestionCommunityStat {
  questionId         String                 @id
  totalResponses     Int                    @default(0)
  correctResponses   Int                    @default(0)
  incorrectResponses Int                    @default(0)
  incorrectRate      Float                  @default(0)
  difficultyBand     QuestionDifficultyBand @default(D)
  calculatedAt       DateTime               @default(now())
  question           Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([difficultyBand])
}

model BunnyStreamWebhookEvent {
  id           String   @id @default(cuid())
  eventKey     String   @unique
  bunnyVideoId String
  status       Int
  payload      Json
  receivedAt   DateTime @default(now())

  @@index([receivedAt])
}

model ContentPlacement {
  id                String   @id @default(cuid())
  contentItemId     String   @unique
  courseId          String?
  chapterId         String?
  lessonId          String?
  sectionId         String?
  academicGradeId   String
  subjectId         String
  resolvedCourseId  String
  resolvedChapterId String?
  resolvedLessonId  String?
  resolvedSectionId String?
  sortOrder         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  course      Course?     @relation("ContentPlacementCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapter     Chapter?    @relation("ContentPlacementChapter", fields: [chapterId], references: [id], onDelete: Restrict)
  lesson      Lesson?     @relation("ContentPlacementLesson", fields: [lessonId], references: [id], onDelete: Restrict)
  section     Section?    @relation("ContentPlacementSection", fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([courseId, sortOrder, id])
  @@index([chapterId, sortOrder, id])
  @@index([lessonId, sortOrder, id])
  @@index([sectionId, sortOrder, id])
  @@index([subjectId, resolvedCourseId, resolvedChapterId])
  @@index([academicGradeId, subjectId])
}

/// The only persisted content-completion state. Progress above an item is
/// intentionally derived from these rows, rather than stored redundantly.
model StudentContentProgress {
  id            String         @id @default(cuid())
  studentUserId String
  contentItemId String
  completedAt   DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, contentItemId])
  @@index([studentUserId, completedAt])
  @@index([contentItemId])
}

/// A private text-range annotation on an authored question. Highlights are
/// intentionally immutable after creation so clients can safely reconstruct
/// the original selection from its persisted offsets and text.
model StudentQuestionHighlight {
  id            String         @id @default(cuid())
  studentUserId String
  questionId    String
  selectedText  String
  startOffset   Int
  endOffset     Int
  color         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentUserId, questionId, createdAt, id])
  @@index([questionId])
}

/// A global private notebook page. It deliberately has no content hierarchy
/// foreign key: pages follow the student across questions, subjects and courses.
model StudentNotebookPage {
  id            String         @id @default(cuid())
  studentUserId String
  title         String
  content       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)

  @@index([studentUserId, updatedAt, id])
}

/// Key/value data used by subject-specific public tools such as calculators.
model SubjectConstant {
  id        String   @id @default(cuid())
  subjectId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, key])
  @@index([subjectId, createdAt, id])
}

/// Private learner activity state. Completion remains intentionally separate
/// in StudentContentProgress so opening or resuming content never changes
/// course-progress calculations.
model StudentContentStudyState {
  id                      String         @id @default(cuid())
  studentUserId           String
  contentItemId           String
  lastOpenedAt            DateTime
  playbackPositionSeconds Int?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  student                 StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  contentItem             ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, contentItemId])
  @@index([studentUserId, lastOpenedAt, id])
  @@index([contentItemId])
}

/// Every submission is retained, including wrong answers and retries.
model StudentQuestionAttempt {
  id            String                         @id @default(cuid())
  studentUserId String
  questionId    String
  attemptNumber Int
  isCorrect     Boolean
  submittedAt   DateTime                       @default(now())
  student       StudentProfile                 @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  question      Question                       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers       StudentQuestionAttemptAnswer[]

  @@unique([studentUserId, questionId, attemptNumber])
  @@index([studentUserId, submittedAt])
  @@index([questionId, submittedAt])
}

model StudentQuestionAttemptAnswer {
  id        String                 @id @default(cuid())
  attemptId String
  optionId  String
  attempt   StudentQuestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  option    QuestionOption         @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, optionId])
  @@index([optionId])
}

model StudentEntitlement {
  id                      String                   @id @default(cuid())
  studentUserId           String
  student                 StudentProfile           @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  courseId                String?
  course                  Course?                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  chapterId               String?
  chapter                 Chapter?                 @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  orderItemId             String?                  @unique
  orderItem               OrderItem?               @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  source                  EntitlementSource        @default(ADMIN)
  status                  EntitlementStatus        @default(ACTIVE)
  startsAt                DateTime                 @default(now())
  expiresAt               DateTime?
  revokedAt               DateTime?
  grantedById             String
  grantedBy               User                     @relation("EntitlementGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedById             String?
  revokedBy               User?                    @relation("EntitlementRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  archivedAccessSnapshots ArchivedAccessSnapshot[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([studentUserId, status, startsAt, expiresAt])
  @@index([courseId])
  @@index([chapterId])
}

/// A durable record that a student held an effective entitlement when a hierarchy
/// node was archived. It intentionally survives expiry/revocation of its source.
model ArchivedAccessSnapshot {
  id                  String                     @id @default(cuid())
  studentUserId       String
  student             StudentProfile             @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  resourceType        ArchivedAccessResourceType
  resourceId          String
  sourceEntitlementId String
  sourceEntitlement   StudentEntitlement         @relation(fields: [sourceEntitlementId], references: [id], onDelete: Restrict)
  archivedAt          DateTime
  revokedAt           DateTime?
  revokedById         String?
  revokedBy           User?                      @relation("ArchivedAccessRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt           DateTime                   @default(now())

  @@unique([studentUserId, resourceType, resourceId])
  @@index([studentUserId, revokedAt])
  @@index([resourceType, resourceId])
}

model Cart {
  id            String         @id @default(cuid())
  studentUserId String         @unique
  student       StudentProfile @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)
  items         CartItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model CartItem {
  id         String             @id @default(cuid())
  cartId     String
  cart       Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  targetType CommerceTargetType
  courseId   String?
  course     Course?            @relation("CartItemCourse", fields: [courseId], references: [id], onDelete: Restrict)
  chapterId  String?
  chapter    Chapter?           @relation("CartItemChapter", fields: [chapterId], references: [id], onDelete: Restrict)
