  @@index([batchId, status])
}

model QuestionImportItem {
  id                    String                              @id @default(cuid())
  batchId               String
  batch                 QuestionImportBatch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chunkId               String?
  chunk                 QuestionImportChunk?                @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sequence              Int
  status                QuestionImportItemStatus
  rawOutput             Json?
  normalizedOutput      Json?
  confidence            Float?
  warnings              Json?
  sourceLocator         Json?
  errorDetail           String?
  questionId            String?                             @unique
  question              Question?                           @relation(fields: [questionId], references: [id], onDelete: SetNull)
  sourceNumber          String?
  globalOrder           Int?
  section               String?
  detectedType          String?
  exclusionReason       String?
  answerOrigin          QuestionAnswerProvenance?
  citedEvidenceKeys     Json?
  reviewerCandidate     Json?
  reviewedAt            DateTime?
  reviewedById          String?
  reviewNote            String?
  visualState           QuestionImportVisualResolutionState @default(NOT_REQUIRED)
