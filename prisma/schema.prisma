generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PARTNER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PartnerType {
  CONTENT_PUBLISHER
  REFERRAL_PARTNER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentItemType {
  TEXT
  EXTERNAL_LINK
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  DOWNLOADABLE_FILE
}

enum AccessType {
  PUBLIC
  FREE
  PAID
  INHERIT
}

enum EntitlementSource {
  ADMIN
  PROMOTION
  MIGRATION
  PAYMENT
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

enum CommerceTargetType {
  COURSE
  CHAPTER
}

enum OrderStatus {
  AWAITING_PAYMENT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum PaymentChannel {
  MANUAL
  PAYMOB
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  PAID
  DECLINED
  FAILED
  EXPIRED
}

enum PromotionKind {
  PERCENTAGE
  FIXED
}

enum CouponReservationStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum ManualPaymentSubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublisherAgreementStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PartnerAllocationKind {
  PUBLISHER_SALE
  REFERRAL_COMMISSION
}

enum PartnerAllocationState {
  PENDING
  PAYABLE
  PAID
  REVERSED
}

/// The direct hierarchy scope represented by a publisher-usage rollup row.
/// ALL is the canonical non-duplicated publisher/source total; narrower rows
/// support a selected frozen curriculum node without changing raw attempts.
enum PublisherUsageScope {
  ALL
  SUBJECT
  COURSE
  CHAPTER
  LESSON
  SECTION
}

enum PartnerFinanceReconciliationStatus {
  DRAFT
  RUNNING
  COMPLETED
}

enum PartnerFinanceDiscrepancySeverity {
  INFO
  WARNING
  ERROR
}

enum PartnerFinanceDiscrepancyStatus {
  OPEN
  ASSIGNED
  RESOLVED
  ACCEPTED
}

enum ReferralProgramStatus {
  DRAFT
  ACTIVE
  ENDED
  SUSPENDED
}

enum ReferralCommissionKind {
  PERCENTAGE
  FIXED_PER_SALE
  PERCENTAGE_CAPPED
}

// A hard checkout block rejects use of a code. Queue rules preserve the
// checkout and create an operator-visible flag after the attribution exists.
enum ReferralReviewRuleKind {
  STUDENT_PROGRAM_APPROVED_SALES
  STUDENT_CODE_APPROVED_SALES
}

enum ReferralReviewAction {
  BLOCK_CHECKOUT
  QUEUE_REVIEW
}

enum ReferralReviewFlagSource {
  AUTOMATED
  MANUAL
}

enum ReferralReviewStatus {
  OPEN
  ASSIGNED
  RESOLVED
  ACCEPTED
}

enum ReferralReviewDisposition {
  CLEARED
  CONFIRMED_FRAUD
  NO_ACTION
  ESCALATED
}

enum AssessmentAttributionRole {
  PRIMARY
  CONTRIBUTOR
  UNKNOWN_LEGACY
}

enum ReportExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum ReportDataClassification {
  NON_PII
  PII_RESTRICTED
}

enum AssetProvider {
  BUNNY_STORAGE
  BUNNY_STREAM
}

enum AssetKind {
  COVER_IMAGE
  IMAGE
  PAYMENT_PROOF
  PDF
  DOCUMENT
  DOWNLOADABLE_FILE
  VIDEO
}

enum AssetStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED_AWAITING_PROCESSING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum AssetReferenceType {
  CONTENT_ATTACHMENT
}

enum ArchivedAccessResourceType {
  ACADEMIC_GRADE
  SUBJECT
  COURSE
  CHAPTER
  LESSON
  SECTION
}

enum VideoProcessingStatus {
  CREATED
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum QuestionSourceType {
  PLATFORM
  CONTENT_PUBLISHER
  EXTERNAL_BOOK
  PREVIOUS_EXAM
  MINISTRY_MODEL
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_ANSWER
  FILL_IN_THE_BLANK
  LONG_ANSWER
}

enum QuestionContextType {
  TEXT
  IMAGE
  TABLE
  EQUATION
}

/// Ordered, typed fragments used by questions, answer options, and reusable
/// contexts. IMAGE is intentionally image-only; ASSET is used for every other
/// ready, student-deliverable asset kind.
enum QuestionContentBlockType {
  TEXT
  IMAGE
  ASSET
  TABLE
  EQUATION
}

enum QuestionExplanationOrigin {
  AI
  HUMAN
}

enum QuestionAiExplanationRunMode {
  INFER
  GROUNDED
}

enum QuestionAiExplanationRunStatus {
  PENDING_REVIEW
  APPLIED
  REJECTED
  FAILED
}

enum QuestionAnswerOrigin {
  EXPLICIT
  INFERRED
}

enum QuestionAnswerProvenance {
  OFFICIAL
  SOURCE_MARKED
  AI_INFERRED
  HUMAN_REVIEWED
}

enum QuestionImportInputType {
  RAW_TEXT
  ASSET
}

enum QuestionImportStatus {
  QUEUED
  EXTRACTING
  TRANSCRIBING
  SEGMENTING
  AWAITING_REVIEW
  GENERATING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum QuestionImportPageStatus {
  PENDING
  PROCESSING
  EXCLUDED
  AI_TRANSCRIBED
  REVIEW_REQUIRED
  FAILED
}

enum QuestionImportPageKind {
  COVER_OR_INDEX
  QUESTION
  ANSWER_FORM
}

enum QuestionImportChunkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QuestionImportItemStatus {
  PROCESSING
  CREATED
  REVIEW_REQUIRED
  EXCLUDED
  INVALID
  FAILED
}

enum QuestionImportMediaStatus {
  REVIEW_REQUIRED
  ELIGIBLE
  REJECTED
  FAILED
}

enum QuestionImportMediaType {
  DIAGRAM
  CHART
  MAP
  TABLE
  EQUATION
  PHOTO
  OPTION_IMAGE
  OTHER_INSTRUCTIONAL
}

enum QuestionImportMediaDetectionSource {
  AI
  MANUAL
}

/// Ownership is separate from crop readiness: an ELIGIBLE crop still needs a
/// validated decision before it becomes student-visible content.
enum QuestionImportMediaAssignmentOwner {
  QUESTION
  OPTION
  CONTEXT
}

enum QuestionImportMediaAssignmentStatus {
  PROPOSED
  VERIFIED
  APPROVED
  REJECTED
}

/// The role a visual must satisfy before a candidate can be answered or
/// materialized.  Requirements are deliberately separate from assignments:
/// assignments are evidence, requirements are the acceptance contract.
enum QuestionImportVisualRequirementKind {
  NONE
  QUESTION_FIGURE
  COMPOSITE_OPTION_FIGURE
  OPTION_IMAGE_SET
  SHARED_STIMULUS
}

enum QuestionImportVisualResolutionState {
  NOT_REQUIRED
  PENDING
  RESOLVED
  UNRESOLVED
  AMBIGUOUS
  INCOMPLETE_CROP
}

enum QuestionImportMediaCropCompleteness {
  UNKNOWN
  COMPLETE
  POSSIBLY_CLIPPED
  INCOMPLETE
}

enum AssessmentOwnerType {
  STUDENT
  ADMIN
}

enum AssessmentGenerationType {
  STANDARD
  CUSTOM
  AI_PROMPT
}

enum AssessmentMode {
  TUTOR
  EXAM
}

enum AssessmentStatus {
  DRAFT
  READY
  ARCHIVED
}

enum AssessmentAttemptStatus {
  SUSPENDED
  COMPLETED
}

enum AssessmentQuestionOutcome {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  OMITTED
  PENDING_GRADING
  PENDING_AI_GRADING
}

enum AnswerInputMethod {
  TEXT
  VOICE_TRANSCRIPT
}

enum AiRunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum QuestionReportType {
  WRONG_ANSWER
  UNCLEAR_WORDING
  TYPO_LANGUAGE
  MISSING_OR_BROKEN_MEDIA
  DUPLICATE
  OTHER
}

enum QuestionReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum QuestionDifficultyBand {
  A_PLUS
  A
  B
  C
  D
}

model User {
  id                 String        @id @default(cuid())
  role               Role
  status             AccountStatus @default(ACTIVE)
  loginIdentifier    String        @unique
  passwordHash       String
  mustChangePassword Boolean       @default(false)
  passwordResetAt    DateTime?
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?
  deletedBy          User?         @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers       User[]        @relation("UserDeletedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  studentProfile                      StudentProfile?
  partnerProfile                      PartnerProfile?
  authSessions                        AuthSession[]
  auditLogsActor                      AdminAuditLog[]
  partnerProfilesCreated              PartnerProfile[]                  @relation("PartnerProfileCreatedBy")
  entitlementsGranted                 StudentEntitlement[]              @relation("EntitlementGrantedBy")
  entitlementsRevoked                 StudentEntitlement[]              @relation("EntitlementRevokedBy")
  manualPaymentMethodsCreated         ManualPaymentMethod[]             @relation("ManualPaymentMethodCreatedBy")
  manualPaymentSubmissionsReviewed    ManualPaymentSubmission[]         @relation("ManualPaymentSubmissionReviewedBy")
  refundRequestsReviewed              RefundRequest[]                   @relation("RefundRequestReviewedBy")
  publisherAgreementsCreated          PublisherAgreement[]              @relation("PublisherAgreementCreatedBy")
  refundPoliciesUpdated               RefundPolicy[]                    @relation("RefundPolicyUpdatedBy")
  reconciliationRunsCreated           PartnerFinanceReconciliationRun[] @relation("ReconciliationRunCreatedBy")
  reconciliationDiscrepanciesAssigned PartnerFinanceDiscrepancy[]       @relation("ReconciliationDiscrepancyAssignedTo")
  reconciliationDiscrepanciesResolved PartnerFinanceDiscrepancy[]       @relation("ReconciliationDiscrepancyResolvedBy")
  referralReviewRulesCreated          ReferralReviewRule[]              @relation("ReferralReviewRuleCreatedBy")
  referralReviewFlagsAssigned         ReferralReviewFlag[]              @relation("ReferralReviewFlagAssignedTo")
  referralReviewFlagsResolved         ReferralReviewFlag[]              @relation("ReferralReviewFlagResolvedBy")
  referralReviewNotesCreated          ReferralReviewNote[]              @relation("ReferralReviewNoteCreatedBy")
  reportExportsRequested              ReportExportJob[]                 @relation("ReportExportRequestedBy")

  academicGradesCreated     AcademicGrade[]           @relation("AcademicGradeCreatedBy")
  academicGradesUpdated     AcademicGrade[]           @relation("AcademicGradeUpdatedBy")
  subjectsCreated           Subject[]                 @relation("SubjectCreatedBy")
  subjectsUpdated           Subject[]                 @relation("SubjectUpdatedBy")
  coursesCreated            Course[]                  @relation("CourseCreatedBy")
  coursesUpdated            Course[]                  @relation("CourseUpdatedBy")
  chaptersCreated           Chapter[]                 @relation("ChapterCreatedBy")
  chaptersUpdated           Chapter[]                 @relation("ChapterUpdatedBy")
  lessonsCreated            Lesson[]                  @relation("LessonCreatedBy")
  lessonsUpdated            Lesson[]                  @relation("LessonUpdatedBy")
  sectionsCreated           Section[]                 @relation("SectionCreatedBy")
  sectionsUpdated           Section[]                 @relation("SectionUpdatedBy")
  contentItemsCreated       ContentItem[]             @relation("ContentItemCreatedBy")
  contentItemsUpdated       ContentItem[]             @relation("ContentItemUpdatedBy")
  assetsUploaded            Asset[]                   @relation("AssetUploadedBy")
  archivedAccessRevocations ArchivedAccessSnapshot[]  @relation("ArchivedAccessRevokedBy")
  questionSourcesCreated    QuestionSource[]          @relation("QuestionSourceCreatedBy")
  questionSourcesUpdated    QuestionSource[]          @relation("QuestionSourceUpdatedBy")
  questionBanksCreated      QuestionBank[]            @relation("QuestionBankCreatedBy")
  questionBanksUpdated      QuestionBank[]            @relation("QuestionBankUpdatedBy")
  questionsCreated          Question[]                @relation("QuestionCreatedBy")
  questionsUpdated          Question[]                @relation("QuestionUpdatedBy")
  questionsReviewed         Question[]                @relation("QuestionReviewedBy")
  questionAnswersReviewed   Question[]                @relation("QuestionAnswerReviewedBy")
  assessmentAnswersGraded   AssessmentAttemptAnswer[] @relation("AssessmentAnswerGradedBy")
  questionReportsReviewed   QuestionReport[]          @relation("QuestionReportReviewedBy")
  questionReportActions     QuestionReportAction[]    @relation("QuestionReportActionActor")
  questionImportsCreated    QuestionImportBatch[]     @relation("QuestionImportCreatedBy")
  assessmentsCreated        Assessment[]              @relation("AssessmentCreatedByAdmin")
  leaderboardWeeksFinalized LeaderboardWeek[]         @relation("LeaderboardWeekFinalizedBy")
  discountCampaignsCreated  DiscountCampaign[]        @relation("DiscountCampaignCreatedBy")
  discountCampaignsUpdated  DiscountCampaign[]        @relation("DiscountCampaignUpdatedBy")
  couponsCreated            Coupon[]                  @relation("CouponCreatedBy")
  couponsUpdated            Coupon[]                  @relation("CouponUpdatedBy")

  @@index([role])
  @@index([role, createdAt, id])
  @@index([deletedById])
}

model StudentProfile {
  userId                  String                     @id
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  archivedAccessSnapshots ArchivedAccessSnapshot[]
  questionMarks           StudentQuestionMark[]
  questionNotes           StudentQuestionNote[]
  questionHighlights      StudentQuestionHighlight[]
  notebookPages           StudentNotebookPage[]
  couponReservations      CouponReservation[]
  questionReports         QuestionReport[]
  aiQuizRuns              AiQuizGenerationRun[]
  fullName                String
  nationalIdHash          String                     @unique
  nationalIdEncrypted     String?
  nationalIdLast4         String
  nationalIdKeyVersion    Int                        @default(1)
  academicGradeId         String?
  academicGrade           AcademicGrade?             @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)
  governorate             String
  center                  String?
  governorateId           String
  centerId                String?
  governorateRef          Governorate?               @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  centerRef               Center?                    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  parentPhoneNormalized   String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  entitlements            StudentEntitlement[]
  contentStudyStates      StudentContentStudyState[]
  cart                    Cart?
  orders                  Order[]
  refundRequests          RefundRequest[]
  referralAttributions    OrderReferralAttribution[]
  parentAccessSessions    ParentAccessSession[]
  contentProgress         StudentContentProgress[]
  questionAttempts        StudentQuestionAttempt[]
  assessments             Assessment[]
  assessmentAttempts      AssessmentAttempt[]
  leaderboardEntries      LeaderboardEntry[]

  @@unique([userId, parentPhoneNormalized])
  @@index([parentPhoneNormalized])
  @@index([parentPhoneNormalized, createdAt, userId])
  @@index([academicGradeId])
  @@index([governorateId])
  @@index([centerId])
}

model PartnerProfile {
  userId              String                      @id
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerType         PartnerType
  displayName         String
  legalName           String?
  phone               String?
  createdByAdminId    String
  createdByAdmin      User                        @relation("PartnerProfileCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  publisherAgreements PublisherAgreement[]        @relation("AgreementPublisher")
  questionSources     QuestionSource[]            @relation("QuestionSourcePublisher")
  referralPrograms    ReferralProgram[]           @relation("ReferralProgramPartner")
  allocations         PartnerAllocation[]         @relation("AllocationPartner")
  settlements         PartnerSettlement[]         @relation("SettlementPartner")
  usageRollups        PublisherUsageDailyRollup[]
  usageSolverPresence PublisherUsageDailySolver[]
}

model AuthSession {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash    String       @unique
  familyId            String
  revoked             Boolean      @default(false)
  revokedAt           DateTime?
  replacedBySessionId String?      @unique
  replacedBy          AuthSession? @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: Restrict)
  replaces            AuthSession? @relation("AuthSessionReplacement")
  ipAddress           String?
  userAgent           String?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())

  @@index([userId])
  @@index([familyId])
}

model ParentAccessSession {
  id                    String          @id @default(cuid())
  parentPhoneNormalized String
  activeStudentId       String?
  activeStudent         StudentProfile? @relation(fields: [activeStudentId, parentPhoneNormalized], references: [userId, parentPhoneNormalized], onDelete: Restrict)
  revoked               Boolean         @default(false)
  revokedAt             DateTime?
  ipAddress             String?
  userAgent             String?
  expiresAt             DateTime
  createdAt             DateTime        @default(now())

  @@index([parentPhoneNormalized])
  @@index([activeStudentId])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id])
  action        String
  targetType    String
  targetId      String
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

model AcademicGrade {
  id            String        @id @default(cuid())
  titleAr       String
  titleEn       String?
  slug          String
  descriptionAr String?
  descriptionEn String?
  sortOrder     Int
  status        ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("AcademicGradeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("AcademicGradeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  subjects        Subject[]
  studentProfiles StudentProfile[]
  coverAsset      Asset?           @relation("AcademicGradeCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId    String?

  @@unique([slug])
  @@unique([sortOrder])
  @@index([status, sortOrder, id])
}

model Subject {
  id              String        @id @default(cuid())
  academicGradeId String
  academicGrade   AcademicGrade @relation(fields: [academicGradeId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy User @relation("SubjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SubjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  courses       Course[]
  questionBanks QuestionBank[]
  constants     SubjectConstant[]
  coverAsset    Asset?            @relation("SubjectCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId  String?

  @@unique([academicGradeId, slug])
  @@unique([academicGradeId, sortOrder])
  @@index([academicGradeId, status, sortOrder, id])
}

model Course {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(PAID)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean    @default(false)

  createdBy User @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  chapters            Chapter[]
  questions           Question[]
  questionPlacements  QuestionPlacement[]      @relation("QuestionPlacementCourse")
  assessmentScopes    AssessmentScope[]        @relation("AssessmentScopeCourse")
  entitlements        StudentEntitlement[]
  cartItems           CartItem[]               @relation("CartItemCourse")
  orderItems          OrderItem[]              @relation("OrderItemCourse")
  discountTargets     DiscountCampaignTarget[] @relation("DiscountCampaignTargetCourse")
  couponTargets       CouponTarget[]           @relation("CouponTargetCourse")
  publisherAgreements PublisherAgreement[]     @relation("PublisherAgreementCourse")
  referralPrograms    ReferralProgram[]        @relation("ReferralProgramCourse")
  contentPlacements   ContentPlacement[]       @relation("ContentPlacementCourse")
  coverAsset          Asset?                   @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?

  @@unique([subjectId, slug])
  @@unique([subjectId, sortOrder])
  @@index([subjectId, status, sortOrder, id])
}

model Chapter {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(INHERIT)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean?

  createdBy User @relation("ChapterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  lessons             Lesson[]
  entitlements        StudentEntitlement[]
  cartItems           CartItem[]               @relation("CartItemChapter")
  orderItems          OrderItem[]              @relation("OrderItemChapter")
  discountTargets     DiscountCampaignTarget[] @relation("DiscountCampaignTargetChapter")
  couponTargets       CouponTarget[]           @relation("CouponTargetChapter")
  publisherAgreements PublisherAgreement[]     @relation("PublisherAgreementChapter")
  referralPrograms    ReferralProgram[]        @relation("ReferralProgramChapter")
  contentPlacements   ContentPlacement[]       @relation("ContentPlacementChapter")
  questionPlacements  QuestionPlacement[]      @relation("QuestionPlacementChapter")
  assessmentScopes    AssessmentScope[]        @relation("AssessmentScopeChapter")
  coverAsset          Asset?                   @relation("ChapterCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?

  @@unique([courseId, slug])
  @@unique([courseId, sortOrder])
  @@index([courseId, status, sortOrder, id])
}

model Lesson {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  updatedById   String
  accessType    AccessType @default(INHERIT)
  priceMinor    Int?
  currency      String?
  isPurchasable Boolean?

  createdBy User @relation("LessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("LessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sections            Section[]
  publisherAgreements PublisherAgreement[] @relation("PublisherAgreementLesson")
  contentPlacements   ContentPlacement[]   @relation("ContentPlacementLesson")
  coverAsset          Asset?               @relation("LessonCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId        String?
  questionPlacements  QuestionPlacement[]  @relation("QuestionPlacementLesson")
  assessmentScopes    AssessmentScope[]    @relation("AssessmentScopeLesson")

  @@unique([chapterId, slug])
  @@unique([chapterId, sortOrder])
  @@index([chapterId, status, sortOrder, id])
}

model Section {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  title       String
  slug        String
  description String?
  sortOrder   Int
  status      ContentStatus @default(DRAFT)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String
  accessType  AccessType @default(INHERIT)

  createdBy User @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("SectionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  contentPlacements  ContentPlacement[]  @relation("ContentPlacementSection")
  coverAsset         Asset?              @relation("SectionCover", fields: [coverAssetId], references: [id], onDelete: Restrict)
  coverAssetId       String?
  questionPlacements QuestionPlacement[] @relation("QuestionPlacementSection")
  assessmentScopes   AssessmentScope[]   @relation("AssessmentScopeSection")

  @@unique([lessonId, slug])
  @@unique([lessonId, sortOrder])
  @@index([lessonId, status, sortOrder, id])
}

model ContentItem {
  id                String          @id @default(cuid())
  type              ContentItemType
  title             String
  description       String?
  textBody          String?
  externalUrl       String?
  accessType        AccessType      @default(INHERIT)
  estimatedDuration Int?
  status            ContentStatus   @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  createdById String
  updatedById String

  createdBy          User                       @relation("ContentItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User                       @relation("ContentItemUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  placement          ContentPlacement?
  primaryAssetId     String?
