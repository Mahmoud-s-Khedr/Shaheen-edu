# Public API hostname. DNS A/AAAA records must point to this server.
API_DOMAIN=api.test.example.com

POSTGRES_USER=edu_test
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=edu_test

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Exact comma-separated browser origins. Never use * with credentialed CORS.
CORS_ORIGINS=https://frontend.example.test,http://localhost:3000,http://localhost:5173

# Cross-site frontend origins need HTTPS plus SameSite=None.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PARENT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_PARENT_ACCESS_TTL_SECONDS=1800
NATIONAL_ID_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_KEY_VERSION=1

SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Use dedicated non-production Bunny Storage and Stream resources.
BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=your-test-storage-zone
BUNNY_STORAGE_ACCESS_KEY_ID=your-test-storage-zone
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-me
BUNNY_STORAGE_PULL_ZONE_URL=https://your-test-zone.b-cdn.net
BUNNY_STORAGE_TOKEN_KEY=replace-with-private-pull-zone-token-key
ASSET_URL_TTL_SECONDS=300
ASSET_IMAGE_MAX_BYTES=10485760
ASSET_DOCUMENT_MAX_BYTES=26214400
ASSET_DOWNLOAD_MAX_BYTES=104857600

BUNNY_STREAM_LIBRARY_ID=replace-me
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_READ_ONLY_KEY=replace-me
BUNNY_STREAM_PLAYER_TOKEN_KEY=replace-me
BUNNY_STREAM_UPLOAD_TTL_SECONDS=10800
BUNNY_STREAM_PLAYBACK_TTL_SECONDS=300
