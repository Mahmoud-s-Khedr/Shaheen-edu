# Store the completed .env only in the production secret manager and host.
# Host Nginx uses API_DOMAIN; Docker Compose does not manage Nginx or TLS.
API_DOMAIN=api.example.com
# Docker reaches the host-managed PostgreSQL server through Docker's explicit
# host-gateway mapping. Percent-encode reserved characters in the username or
# password. Do not point this at a Docker service named postgres.
DATABASE_URL=postgresql://edu_production:replace-with-a-long-random-password@host.docker.internal:5432/edu_production?schema=public
# Published only on host loopback for the host Nginx upstream; never use 3000
# because host Nginx owns the public TLS listener there.
API_HOST_PORT=13000
REDIS_PASSWORD=replace-with-a-long-random-password
# Reserve a reviewed amount of RAM for Redis and its persistence overhead.
REDIS_MAXMEMORY=768mb
# Immutable commit SHA or image digest for this deployment.
RELEASE_REVISION=replace-with-the-immutable-release-revision

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
TRUST_PROXY_HOPS=1
API_DOCS_ENABLED=false
CORS_ORIGINS=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_PARENT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_KEY_VERSION=1

# Required only by the explicit `bootstrap` profile, never by normal releases.
ALLOW_PRODUCTION_BOOTSTRAP=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
INITIAL_REFUND_ELIGIBILITY_WINDOW_DAYS=
INITIAL_REFUND_MAXIMUM_CONSUMPTION_BPS=

BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=your-production-storage-zone
BUNNY_STORAGE_ACCESS_KEY_ID=your-production-storage-zone
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-me
BUNNY_STORAGE_PULL_ZONE_URL=https://assets.example.com
BUNNY_STORAGE_TOKEN_KEY=replace-with-private-pull-zone-token-key
BUNNY_STREAM_LIBRARY_ID=replace-me
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_READ_ONLY_KEY=replace-me
BUNNY_STREAM_PLAYER_TOKEN_KEY=replace-me

OPENROUTER_API_KEY=replace-me
AI_QUESTION_IMPORT_MODEL=replace-with-approved-model
AI_PDF_TRANSCRIPTION_MODEL=replace-with-approved-model

# Feature flags stay disabled until an approved rollout record exists.
FEATURE_REFERRALS_ENABLED=false
FEATURE_REFERRAL_ALLOWED_STUDENT_IDS=
FEATURE_PARTNER_LEDGER_ENABLED=false
FEATURE_PARTNER_LEDGER_ALLOWED_USER_IDS=
FEATURE_REPORT_EXPORTS_ENABLED=false
