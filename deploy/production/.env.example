# Complete production configuration contract. Copy this to .env only in the
# host secret manager or on the production host, then replace every
# `replace-with-...` value. Never commit the completed file.
#
# Host Nginx owns the public domain, TLS, and certificate renewal. It is not a
# Docker service, so API_DOMAIN is intentionally not part of this file.

# Release identity
# Returned as `version` by GET /health and GET /health/ready, included in
# structured logs, and attached to Compose service labels.
VERSION=v0.1-beta

# Host PostgreSQL and private Docker Redis
# Docker reaches host PostgreSQL through the explicit host-gateway mapping.
# Percent-encode reserved URL characters in database credentials.
DATABASE_URL=postgresql://shaheen_app:replace-with-a-long-random-password@host.docker.internal:5432/shaheen_edu?schema=public
# Docker Compose derives REDIS_URL internally; do not point it at a public host.
REDIS_PASSWORD=replace-with-a-long-random-password
# Baseline sized for a 2-vCPU / 4-GB VPS. Redis must have allocator/AOF-rewrite
# headroom above REDIS_MAXMEMORY.
REDIS_MAXMEMORY=192mb
REDIS_MEMORY_LIMIT=320mb
# Published only on loopback. Host Nginx proxies to this port.
API_HOST_PORT=13000

# API and reverse-proxy behavior
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
# browser -> host Nginx -> private Compose gateway -> API
TRUST_PROXY_HOPS=2
API_DOCS_ENABLED=false

# Browser access and session cookies
# List every exact frontend origin, comma-separated; wildcard origins are not
# compatible with credentialed browser requests.
CORS_ORIGINS=https://app.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

# User and parent authentication
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PARENT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_PARENT_ACCESS_TTL_SECONDS=1800

# National-ID protection. Preserve old key material until all records using it
# have been deliberately re-encrypted under a newer NATIONAL_ID_KEY_VERSION.
NATIONAL_ID_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
NATIONAL_ID_KEY_VERSION=1

# Bunny Storage assets
BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=your-production-storage-zone
BUNNY_STORAGE_ACCESS_KEY_ID=your-production-storage-zone
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-with-bunny-storage-secret
BUNNY_STORAGE_PULL_ZONE_URL=https://assets.example.com
BUNNY_STORAGE_TOKEN_KEY=replace-with-private-pull-zone-token-key
ASSET_URL_TTL_SECONDS=300
ASSET_UPLOAD_TTL_SECONDS=900
ASSET_IMAGE_MAX_BYTES=10485760
ASSET_DOCUMENT_MAX_BYTES=26214400
ASSET_DOWNLOAD_MAX_BYTES=104857600

# Bunny Stream video delivery
BUNNY_STREAM_LIBRARY_ID=replace-with-bunny-stream-library-id
BUNNY_STREAM_API_KEY=replace-with-bunny-stream-api-key
BUNNY_STREAM_READ_ONLY_KEY=replace-with-bunny-stream-read-only-key
BUNNY_STREAM_PLAYER_TOKEN_KEY=replace-with-bunny-stream-player-token-key
BUNNY_STREAM_UPLOAD_TTL_SECONDS=10800
BUNNY_STREAM_PLAYBACK_TTL_SECONDS=300

# API and authentication rate limits
RATE_LIMIT_GLOBAL_LIMIT=30
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ROUTE_LIMIT=10
RATE_LIMIT_AUTH_ROUTE_WINDOW_SECONDS=60
RATE_LIMIT_STUDENT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_STUDENT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_ADMIN_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PARTNER_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_PARTNER_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PARENT_LOGIN_MAX_ATTEMPTS=3
RATE_LIMIT_PARENT_LOGIN_WINDOW_SECONDS=1800
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_CHANGE_MAX_ATTEMPTS=5
RATE_LIMIT_PASSWORD_CHANGE_WINDOW_SECONDS=900
RATE_LIMIT_IP_MAX_ATTEMPTS=20
RATE_LIMIT_IP_WINDOW_SECONDS=900

# Reporting, privacy, and feature rollout
PLATFORM_COMPARISON_MIN_SAMPLE=10
PRIVACY_REQUIRE_SENSITIVE_360_REASON=true
PRIVACY_REQUIRE_PRIVILEGED_EXPORT_REASON=true
# Leave blank to require a free-form support reason; otherwise use a
# comma-separated approved reason list.
PRIVACY_SUPPORT_REASON_ALLOWLIST=
REFERRAL_PARTNER_MINIMUM_COHORT=1
# All application features are enabled for all eligible users.
FEATURE_REFERRALS_ENABLED=true
FEATURE_REFERRAL_ALLOWED_STUDENT_IDS=*
FEATURE_PARTNER_LEDGER_ENABLED=true
FEATURE_PARTNER_LEDGER_ALLOWED_USER_IDS=*
FEATURE_REPORT_EXPORTS_ENABLED=true

# Paymob. Configure every value with production merchant credentials before
# accepting online payments; callback and redirect URLs must be public HTTPS.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=replace-with-paymob-secret-key
PAYMOB_PUBLIC_KEY=replace-with-paymob-public-key
PAYMOB_HMAC_SECRET=replace-with-paymob-hmac-secret
PAYMOB_INTEGRATION_IDS=replace-with-comma-separated-paymob-integration-ids
PAYMOB_NOTIFICATION_URL=https://api.example.com/api/v1/payments/paymob/webhook
PAYMOB_REDIRECT_URL=https://app.example.com/payment-result
PAYMOB_TIMEOUT_MS=15000
PAYMOB_ORDER_EXPIRY_SECONDS=1800
MANUAL_ORDER_EXPIRY_SECONDS=86400

# OpenRouter AI. Every model ID must be available to the production key and
# approved for its named workload; do not use placeholder IDs in a real .env.
OPENROUTER_API_KEY=replace-with-openrouter-production-api-key
AI_QUESTION_IMPORT_MODEL=replace-with-approved-question-import-model
AI_QUESTION_EXPLANATION_MODEL=replace-with-approved-question-explanation-model
AI_QUIZ_PLANNING_MODEL=replace-with-approved-quiz-planning-model
AI_ANSWER_GRADING_MODEL=replace-with-approved-answer-grading-model
AI_SPEECH_TO_TEXT_MODEL=openai/whisper-large-v3
AI_SPEECH_TO_TEXT_MAX_BYTES=10485760
AI_PDF_TRANSCRIPTION_MODEL=replace-with-approved-native-pdf-model
AI_PDF_TRANSCRIPTION_FALLBACK_MODEL=replace-with-approved-pdf-fallback-model
AI_PDF_TRANSCRIPTION_TIMEOUT_MS=120000
# Conservative limits for a 2-vCPU / 4-GB VPS. Raise only after observing
# memory usage and queue latency under representative production traffic.
AI_PDF_MAX_PAGES=600
AI_WORKER_CONCURRENCY=1
AI_QUESTION_IMPORT_OCR_CONCURRENCY=1
AI_QUESTION_IMPORT_EXTRACTION_CONCURRENCY=1
AI_QUESTION_IMPORT_CANDIDATE_CONCURRENCY=1
AI_REQUEST_TIMEOUT_MS=60000
AI_SEGMENTATION_SPLIT_THRESHOLD_TOKENS=8000
AI_SEGMENTATION_CHILD_TARGET_TOKENS=4000
AI_PDF_SPLIT_OVERLAP_PAGES=2
# Retained for compatibility; token thresholds above control splitting.
AI_SEGMENTATION_MAX_CHARACTERS=500000
AI_EXTRACTION_TARGET_TOKENS=30000
AI_EXTRACTION_MAX_QUESTIONS=10
# Retained for compatibility; token budgets above control extraction chunking.
AI_EXTRACTION_MAX_CHARACTERS=80000

# One-time bootstrap only. Set these after migration succeeds, run the
# bootstrap profile once, then remove these values from the completed .env.
# Bootstrap refuses pending, failed, divergent, or active Prisma migrations.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
INITIAL_REFUND_ELIGIBILITY_WINDOW_DAYS=
INITIAL_REFUND_MAXIMUM_CONSUMPTION_BPS=
