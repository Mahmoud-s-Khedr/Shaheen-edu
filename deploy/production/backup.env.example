# Install as /etc/shaheen-edu/backup.env with mode 0600 and root ownership.
# This is a shell environment file: keep values shell-safe and do not commit
# the completed file. The PostgreSQL role must be able to dump the configured
# database and read the migration table.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=edu_production
PGUSER=edu_backup
# A root-only libpq password file, not a password on the command line.
PGPASSFILE=/etc/shaheen-edu/postgres-backup.pgpass

# A separate root-only storage credential for the private backup destination.
# Do not reuse application asset credentials for backups. Create this file from
# backup-storage.env.example and keep it outside the project checkout.
BACKUP_STORAGE_ENV_FILE=/etc/shaheen-edu/backup-storage.env
OPERATIONS_PREFIX=operations
RESTIC_PASSWORD_FILE=/etc/shaheen-edu/restic-password
BACKUP_STAGING_DIR=/var/lib/shaheen-edu-backups/staging
RESTIC_CACHE_DIR=/var/cache/shaheen-edu-restic

# Retention applies only to database snapshots. The bundled timer runs every
# four hours, so 14 days retains approximately 84 recovery points. Restic
# removes snapshots once they are older than this window.
RESTIC_KEEP_WITHIN=14d
# The weekly verification unit reads the stated percentage of encrypted
# repository pack data.
RESTIC_CHECK_READ_DATA_SUBSET=5%

# Restoration is refused unless the explicit target is in this comma-separated
# list. These must be disposable, non-production databases created by host
# automation; the source database is always refused as a target.
RESTORE_ALLOWED_DATABASES=edu_restore
