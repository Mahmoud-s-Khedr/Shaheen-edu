# Install as /etc/shaheen-edu/backup.env with mode 0600 and ownership root:root.
# Backups and incident-log bundles intentionally use the same private Bunny
# Storage Zone and credentials as application assets. Do not expose the
# operations/ prefix through an application endpoint or a public Pull Zone.

# Root reads the existing production application environment to obtain
# BUNNY_STORAGE_S3_ENDPOINT, BUNNY_STORAGE_BUCKET,
# BUNNY_STORAGE_ACCESS_KEY_ID, and BUNNY_STORAGE_SECRET_ACCESS_KEY.
BUNNY_STORAGE_ENV_FILE=/opt/shaheen-edu/deploy/production/.env

# Keep operations objects distinct from application asset keys. The Restic
# repository defaults to operations/postgres-restic in the shared bucket.
OPERATIONS_PREFIX=operations

# Store this password in a separate root-only file. Keep two offline recovery
# copies with named custodians; it cannot be recovered from Bunny or Restic.
RESTIC_PASSWORD_FILE=/etc/shaheen-edu/restic-password

# Local staging/cache directories. These must be on encrypted production disk
# and are cleaned after each backup attempt.
BACKUP_STAGING_DIR=/var/lib/shaheen-edu-backups/staging
RESTIC_CACHE_DIR=/var/cache/shaheen-edu-restic
