[Unit]
Description=Verify Shaheen Edu encrypted host PostgreSQL backups
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/shaheen-edu/backup.env

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/shaheen-edu/deploy/production
Environment=BACKUP_ENV_FILE=/etc/shaheen-edu/backup.env
ExecStart=/opt/shaheen-edu/deploy/production/scripts/postgres-backup-verify.sh
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/shaheen-edu-restic /run/lock
