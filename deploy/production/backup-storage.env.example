# Install as /etc/shaheen-edu/backup-storage.env with mode 0600 and root
# ownership. Use credentials for a dedicated private backup Storage Zone or
# bucket, distinct from application asset credentials. These values are read
# only by the host backup and verification units.
BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=shaheen-edu-production-backups
BUNNY_STORAGE_ACCESS_KEY_ID=replace-with-backup-storage-access-key
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-with-backup-storage-secret
