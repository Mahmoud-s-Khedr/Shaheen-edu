# Example host-Nginx virtual host. It is not mounted or run by Docker Compose.
# Existing host automation owns domains, certificates, renewal, and the TLS
# directives, which are intentionally omitted here. Replace <api-domain> and
# 13000 with the approved domain and API_HOST_PORT.
# Keep host access and error logs enabled through the existing host logging
# policy. They are essential for incident investigation and remain outside the
# Compose incident-log bundle.

server {
    listen 3000 ssl;
    listen [::]:3000 ssl;
    server_name <api-domain>;

    # Certificate and renewal directives are managed by existing host scripts.
    client_max_body_size 110m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_request_buffering off;
    }
}
