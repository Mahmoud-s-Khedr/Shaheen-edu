# Example host-Nginx virtual host. It is not mounted or run by Docker Compose.
# Existing host automation owns domains, certificates, renewal, and the TLS
# directives, which are intentionally omitted here. The Jibal API is served
# only at api.jibal-platform.com; 13000 must match API_HOST_PORT.
# This is a redacted, diagnostic-only access log. It intentionally omits URI,
# query string, remote address, user agent, cookies, and request bodies. The
# normal host access log is not a diagnostic-bundle source.
map $uri $shaheen_route_class {
    default api_other;
    ~^/health(?:/ready)?$ health;
    ~^/api/v[0-9]+/auth(?:/|$) auth;
    ~^/api/v[0-9]+/student/catalog(?:/|$) student_catalog;
    ~^/api/v[0-9]+/admin(?:/|$) admin;
    ~^/api/v[0-9]+/assets(?:/|$) assets;
}

log_format shaheen_diagnostic_json escape=json
    '{"timestamp":"$time_iso8601","timestampEpochSeconds":$msec,"service":"nginx","correlationId":"$request_id",'
    '"method":"$request_method","status":$status,"upstreamStatus":"$upstream_status",'
    '"requestDurationSeconds":$request_time,"upstreamDurationSeconds":"$upstream_response_time",'
    '"routeClass":"$shaheen_route_class"}';

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.jibal-platform.com;

    # Certificate and renewal directives are managed by existing host scripts.
    client_max_body_size 110m;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    access_log /var/log/nginx/shaheen-edu-diagnostic.jsonl shaheen_diagnostic_json;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Correlation-ID $request_id;
        proxy_request_buffering off;
    }
}
