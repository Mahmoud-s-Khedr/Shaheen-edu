    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "@smithy/node-http-handler": "^4.11.3",
    "argon2": "^0.44.0",
    "bullmq": "^6.1.0",
    "class-transformer": "^0.5.1",
