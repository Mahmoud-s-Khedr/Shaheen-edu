    "evaluate:shared-context-ab": "tsx scripts/evaluate-shared-context-ab.ts",
    "report:ai-model-comparison": "tsx scripts/generate-ai-model-comparison.ts",
    "journey:current": "tsx scripts/run-journey.ts current",
    "journey:test": "tsx --test scripts/journeys/lib/*.test.ts",
    "api:contract:check": "tsx scripts/api-contract-check.ts",
    "api:docs:generate": "ts-node scripts/generate-openapi.ts",
    "api:test:full": "node scripts/api-test.mjs",
    "api:test:testimonials": "node scripts/test-testimonials.mjs",
    "test:all": "pnpm test && pnpm test:e2e && pnpm build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "tsx scripts/run-migration-operation.ts migrate",
    "prisma:bootstrap": "tsx scripts/run-migration-operation.ts bootstrap",
    "prisma:seed": "ts-node prisma/seed.ts",
