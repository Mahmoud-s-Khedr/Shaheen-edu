# Copy this file to .env and adjust as needed. Values below match docker-compose.yml defaults.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Matches docker-compose postgres service (user/password/db = edu/edu_dev_password/edu)
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5433/edu?schema=public
REDIS_URL=redis://localhost:6380

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie settings for the refresh_token cookie
COOKIE_SECURE=false
COOKIE_SECRET=dev_cookie_secret_change_me_to_something_random_32plus

# JWT secrets - MUST be at least 32 chars, generate real random values for real environments
JWT_ACCESS_SECRET=dev_access_secret_change_me_to_something_random_32plus
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PARENT_ACCESS_SECRET=dev_parent_secret_change_me_to_something_random_32
JWT_PARENT_ACCESS_TTL_SECONDS=1800

# National ID protection (HMAC for deterministic lookup hash, AES-256-GCM for reversible storage)
NATIONAL_ID_HMAC_SECRET=dev_national_id_hmac_secret_change_me_random_32plus
NATIONAL_ID_ENCRYPTION_KEY=dev_national_id_encryption_key_change_me_32plus
NATIONAL_ID_KEY_VERSION=1

# Seeded super admin (idempotent seed script - safe to run more than once)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
