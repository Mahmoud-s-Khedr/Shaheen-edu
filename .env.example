# Copy this file to .env and adjust as needed. Values below match docker-compose.yml defaults.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Matches docker-compose postgres service (user/password/db = edu/edu_dev_password/edu)
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5433/edu?schema=public
REDIS_URL=redis://localhost:6380

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookie settings for the refresh_token cookie
COOKIE_SECURE=false
# Allowed values: lax, strict, none. Cross-site browser clients require none with HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_SECRET=dev_cookie_secret_change_me_to_something_random_32plus

# JWT secrets - MUST be at least 32 chars, generate real random values for real environments
JWT_ACCESS_SECRET=dev_access_secret_change_me_to_something_random_32plus
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_PARENT_ACCESS_SECRET=dev_parent_secret_change_me_to_something_random_32
JWT_PARENT_ACCESS_TTL_SECONDS=1800

# Rate limits (all windows are in seconds)
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ROUTE_LIMIT=100
RATE_LIMIT_AUTH_ROUTE_WINDOW_SECONDS=60
RATE_LIMIT_STUDENT_LOGIN_MAX_ATTEMPTS=50
RATE_LIMIT_STUDENT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_ADMIN_LOGIN_MAX_ATTEMPTS=50
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PARTNER_LOGIN_MAX_ATTEMPTS=50
RATE_LIMIT_PARTNER_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PARENT_LOGIN_MAX_ATTEMPTS=30
RATE_LIMIT_PARENT_LOGIN_WINDOW_SECONDS=1800
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=200
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_PASSWORD_CHANGE_MAX_ATTEMPTS=50
RATE_LIMIT_PASSWORD_CHANGE_WINDOW_SECONDS=900
RATE_LIMIT_IP_MAX_ATTEMPTS=200
RATE_LIMIT_IP_WINDOW_SECONDS=900

# National ID protection (HMAC for deterministic lookup hash, AES-256-GCM for reversible storage)
NATIONAL_ID_HMAC_SECRET=dev_national_id_hmac_secret_change_me_random_32plus
NATIONAL_ID_ENCRYPTION_KEY=dev_national_id_encryption_key_change_me_32plus
NATIONAL_ID_KEY_VERSION=1

# Seeded super admin (idempotent seed script - safe to run more than once)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# Bunny Storage (S3 compatibility must be enabled on the Storage Zone)
BUNNY_STORAGE_S3_ENDPOINT=https://ny-s3.storage.bunnycdn.com
BUNNY_STORAGE_BUCKET=your-storage-zone
BUNNY_STORAGE_ACCESS_KEY_ID=your-storage-zone
BUNNY_STORAGE_SECRET_ACCESS_KEY=replace-me
BUNNY_STORAGE_PULL_ZONE_URL=https://your-private-zone.b-cdn.net
BUNNY_STORAGE_TOKEN_KEY=replace-with-private-pull-zone-token-key
ASSET_UPLOAD_TTL_SECONDS=900
ASSET_URL_TTL_SECONDS=300
ASSET_IMAGE_MAX_BYTES=10485760
ASSET_DOCUMENT_MAX_BYTES=52428800
ASSET_DOWNLOAD_MAX_BYTES=104857600

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=replace-me
BUNNY_STREAM_API_KEY=replace-me
BUNNY_STREAM_READ_ONLY_KEY=replace-me
BUNNY_STREAM_PLAYER_TOKEN_KEY=replace-me
BUNNY_STREAM_UPLOAD_TTL_SECONDS=10800
BUNNY_STREAM_PLAYBACK_TTL_SECONDS=300
